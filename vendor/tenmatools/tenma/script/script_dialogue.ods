     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F1138])" office:value-type="string" office:string-value="Abukuma Caves" calcext:value-type="string">
      <text:p>Abukuma Caves</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F1138]); COLUMN([.F1138]); 4)" office:value-type="string" office:string-value="DUPE: F1138" calcext:value-type="string">
