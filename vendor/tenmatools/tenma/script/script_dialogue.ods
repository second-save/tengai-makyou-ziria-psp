      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xDD9F-0xFA_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>５０００００００両になります<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">えっ？　無い・・・　それじゃあ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">泊めることは出来ませんよ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>It&apos;ll be 両50,000,000 for one night...\n</text:p><text:p>What? You don&apos;t have them? Well, then you can&apos;t stay, can you?</text:p>
     </table:table-cell>
