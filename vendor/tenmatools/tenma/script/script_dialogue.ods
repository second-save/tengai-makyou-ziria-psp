     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x25D8-0x68_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアさん　じゃないですかぁ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">こんな所で　遊んでいて　いいんですか</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">まっ　たまには　息ぬきしないとね</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F494])" office:value-type="string" office:string-value="My, if it isn&apos;t Ziria-san!\n&#x0a;Should you really be here?\n&#x0a;Eh, I guess it&apos;s fine every once in a while!" calcext:value-type="string"><text:p>My, if it isn&apos;t Ziria-san!\n</text:p><text:p>Should you really be here?\n</text:p><text:p>Eh, I guess it&apos;s fine every once in a while!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F494]); COLUMN([.F494]); 4)" office:value-type="string" office:string-value="DUPE: F494" calcext:value-type="string">
      <text:p>DUPE: F494</text:p>
     </table:table-cell>
