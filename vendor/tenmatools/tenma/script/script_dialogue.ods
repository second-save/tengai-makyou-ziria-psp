     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>この　宇都宮には<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">勇気のある　若トノさまが</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いらっしゃるのよ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Utsunomiya Town is protected by our brave, young lord!</text:p>
     </table:table-cell>
