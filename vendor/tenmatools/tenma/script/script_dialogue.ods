      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x53DB-0x4B_8</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>あんずることは　なぁい！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">わしの占いは　たまには</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">はずれることも　ある！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>D-Don&apos;t worry! I&apos;ve made mispredictions every once in a while!</text:p>
