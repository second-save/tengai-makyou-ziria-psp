     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Take a look around!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4135]=[.I4135]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
