     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x142B-0xB6_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>それでは　また　ご利用ください</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F108])" office:value-type="string" office:string-value="Come back anytime." calcext:value-type="string">
