     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x489D-0x42A_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>なんだ！　お金もっていないじゃ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ないですか！　かえって　ください</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">教会には　いれられない！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4143])" office:value-type="string" office:string-value="What?! You don&apos;t have enough money?!\n&#x0a;Leave at once! This church isn&apos;t for you!" calcext:value-type="string"><text:p>What?! You don&apos;t have enough money?!\n</text:p><text:p>Leave at once! This church isn&apos;t for you!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4143]); COLUMN([.F4143]); 4)" office:value-type="string" office:string-value="DUPE: F4143" calcext:value-type="string">
