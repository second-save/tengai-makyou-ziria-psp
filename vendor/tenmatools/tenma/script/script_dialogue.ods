      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x54BB-0x5A3_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアの大将！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">どうぞ　お通りください</text:span></text:p>
     </table:table-cell>
