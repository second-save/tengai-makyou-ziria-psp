     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>大門教会</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F575])" office:value-type="string" office:string-value="Daimon Church" calcext:value-type="string">
      <text:p>Daimon Church</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F575]); COLUMN([.F575]); 4)" office:value-type="string" office:string-value="DUPE: F575" calcext:value-type="string">
      <text:p>DUPE: F575</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x4929-0x301_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>この教会の中の　人のほとんどは<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">火事で　家を　失った　人たちです</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4139])" office:value-type="string" office:string-value="These poor souls have lost their homes to a terrible fire." calcext:value-type="string">
      <text:p>These poor souls have lost their homes to a terrible fire.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4139]); COLUMN([.F4139]); 4)" office:value-type="string" office:string-value="DUPE: F4139" calcext:value-type="string">
      <text:p>DUPE: F4139</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x4929-0x301_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>気の毒な　かれらの　ために<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">１００両の　寄付を</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">おねがい　いたします？</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4140])" office:value-type="string" office:string-value="Would you make a donation of 両100 to provide them with the bare necessities?" calcext:value-type="string">
      <text:p>Would you make a donation of 両100 to provide them with the bare necessities?</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4140]); COLUMN([.F4140]); 4)" office:value-type="string" office:string-value="DUPE: F4140" calcext:value-type="string">
      <text:p>DUPE: F4140</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x4929-0x392_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>神は　あなたの　行ないを　<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">いつも　見て　いらっしゃいますよ</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4141])" office:value-type="string" office:string-value="Remember: God is always watching you." calcext:value-type="string">
      <text:p>Remember: God is always watching you.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4141]); COLUMN([.F4141]); 4)" office:value-type="string" office:string-value="DUPE: F4141" calcext:value-type="string">
      <text:p>DUPE: F4141</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x4929-0x3D5_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>なんだ！　お金もっていないじゃ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ないですか！　かえって　ください</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">教会には　いれられない！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4143])" office:value-type="string" office:string-value="What?! You don&apos;t have enough money?!\n&#x0a;Leave at once! This church isn&apos;t for you!" calcext:value-type="string"><text:p>What?! You don&apos;t have enough money?!\n</text:p><text:p>Leave at once! This church isn&apos;t for you!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4143]); COLUMN([.F4143]); 4)" office:value-type="string" office:string-value="DUPE: F4143" calcext:value-type="string">
      <text:p>DUPE: F4143</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x4929-0x434_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>さあ　お入りください<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">同志と　ともに　神に　祈りましょう！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4142])" office:value-type="string" office:string-value="Please, come on in. Let us pray together." calcext:value-type="string">
      <text:p>Please, come on in. Let us pray together.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4142]); COLUMN([.F4142]); 4)" office:value-type="string" office:string-value="DUPE: F4142" calcext:value-type="string">
