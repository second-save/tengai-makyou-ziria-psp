     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>この村にも<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">有名な　占いオババが　おるんじゃ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">よく　当たるゆーて　評判なんじゃ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>A famous fortune teller lives in our town. Her predictions are rarely wrong!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4851]=[.I4851]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
