     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジパングに　キテ　ようろうのタキに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">地雷火を　かくしたネ！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">地雷火　すばらしい　ブキ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>When I come to Jipang, I hide {land mine} in Yourou Falls!\n</text:p><text:p>Land mine is amazing weapon!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5292]=[.I5292]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5C7F-0xF7_10</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>地雷火　さがす　ヨロシイ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">カラクリ兵　たおす　ヨロシイ！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ワタシ　ツカレた！　ネル・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>You find land mine, yes?\n</text:p><text:p>You defeat clockwork soldier, yes?\n</text:p><text:p>I am tired! I sleep now...</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5293]=[.I5293]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
