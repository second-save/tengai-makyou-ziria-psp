     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>塩山</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F3560])" office:value-type="string" office:string-value="Salt Pyramid" calcext:value-type="string">
      <text:p>Salt Pyramid</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F3560]); COLUMN([.F3560]); 4)" office:value-type="string" office:string-value="DUPE: F3560" calcext:value-type="string">
