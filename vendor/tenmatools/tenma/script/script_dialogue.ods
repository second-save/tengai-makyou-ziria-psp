     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>トノさまに　会いたければ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ずっと　おくに　入っていくが　よい</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The lord will receive you. Simply follow the corridors all the way back.</text:p>
     </table:table-cell>
