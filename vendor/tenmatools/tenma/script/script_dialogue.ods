     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>舟は出たばかりだ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">しばらく来ないよ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>The ferry just left.\n</text:p><text:p>It&apos;ll be a while before it comes back.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4452]=[.I4452]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
