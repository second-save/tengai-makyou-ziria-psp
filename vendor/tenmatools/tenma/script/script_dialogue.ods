    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x1383-0xD7_1</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>わしが　剣の名人　ボクデンじゃ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">必殺剣を　ならいたくば　わしを</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">たおしてみよ！　どうだ　たたかうか？</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>I am Bokuden, master of the blade!\n</text:p><text:p>If you can defeat me, I will teach you a special technique! Up for a fight?</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F259]=[.I259]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x1383-0x157_1</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ええい！こしぬけめ！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">さっさと　かえれ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Tch! Coward!\n</text:p><text:p>Get out of my sight!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F260]=[.I260]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x1383-0x18E_1</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアよ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">わしは　よい　デシを　もった</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">さあ　行くのじゃ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>You are a worthy pupil, Ziria!\n</text:p><text:p>Go forth, young hero!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F261]=[.I261]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
