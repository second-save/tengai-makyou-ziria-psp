     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x6554-0xB9_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>グウウウオオオ！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">無数の　たましいが</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ヤミの底より　叫び！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Aaahhh!! The screams! The screaaams!!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5988]=[.I5988]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
