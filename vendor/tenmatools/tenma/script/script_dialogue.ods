     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x181B-0x26E_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>わたし　チョット　つかれたデスヨ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">自来也さん　わたし　休みたいデス！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>I&apos;m tired!\n</text:p><text:p>Ziria-san, let me rest!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>CHECK, Hoteimaru&apos;s accent</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=IF([.F727]=[.I727]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
