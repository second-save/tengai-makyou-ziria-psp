      <text:p>map-0x4929-0x473_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>さあ　どうぞ　なかへ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">みなさん　あつまってますよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Please, come on in and join the others.</text:p>
     </table:table-cell>
