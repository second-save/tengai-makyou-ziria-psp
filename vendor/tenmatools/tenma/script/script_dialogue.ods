     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>火の勇者よ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">「力」を　あたえよう！</text:span></text:p>
     </table:table-cell>
