     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3558-0x15B_4</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>やっと　マントーから<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">かいほう　されました</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>I&apos;m finally free from Manto&apos;s clutches!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F2966]=[.I2966]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
