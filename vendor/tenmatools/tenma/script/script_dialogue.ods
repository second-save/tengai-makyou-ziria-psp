     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>この教会の　中の　人のほとんどは<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">水害で　田畑を　失った　人たちです</text:span></text:p>
     </table:table-cell>
