     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x657F-0x5DD_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>[f6]&lt;$32&gt;<text:span text:style-name="T2">はやく江戸へ行かないと</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">邪神斎の力がますます大きくなる</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">急げ自来也</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>[f6]&lt;$32&gt;If we don&apos;t get to Edo soon, Jashinsai will gain greater strength.\n</text:p><text:p>Let&apos;s hurry, Ziria.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F6002]=[.I6002]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
