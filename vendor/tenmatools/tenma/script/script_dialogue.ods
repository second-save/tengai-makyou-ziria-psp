     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ドカッ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">と　けりを入れる</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ツナデだった</text:span></text:p>
     </table:table-cell>
