      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x56EB-0x29_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>宿屋</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F111])" office:value-type="string" office:string-value="Inn" calcext:value-type="string">
      <text:p>Inn</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F111]); COLUMN([.F111]); 4)" office:value-type="string" office:string-value="DUPE: F111" calcext:value-type="string">
      <text:p>DUPE: F111</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x56EB-0x71_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>大門教に　つかまった人は<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">神奈川村から　獄門島へ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">送られて　いるんですよ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The Cult of Daimon sends their prisoners to Gokumon Island from Kanagawa Village.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4948]=[.I4948]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x56EB-0xB9_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアさん<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">大門教打倒の日まで</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">がんばってください</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4868])" office:value-type="string" office:string-value="Never stop fighting the Cult of Daimon, Ziria-san." calcext:value-type="string">
      <text:p>Never stop fighting the Cult of Daimon, Ziria-san.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4868]); COLUMN([.F4868]); 4)" office:value-type="string" office:string-value="DUPE: F4868" calcext:value-type="string">
      <text:p>DUPE: F4868</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x56EB-0xEF_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>神奈川の港に<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">大門教の　船が</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">泊まっているのを　見たわ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>I saw a Daimonist ship docked at Kanagawa&apos;s harbor.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4950]=[.I4950]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x56EB-0xEF_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>きっと　あの船に<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お捜しの人たちも</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">乗せられているに　ちがいないわ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>It&apos;s likely that your friends are on that ship!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4951]=[.I4951]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x56EB-0x186_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いらっしゃいませ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ここは　宿屋でございます</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F117])" office:value-type="string" office:string-value="Welcome to the inn!" calcext:value-type="string">
      <text:p>Welcome to the inn!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F117]); COLUMN([.F117]); 4)" office:value-type="string" office:string-value="DUPE: F117" calcext:value-type="string">
      <text:p>DUPE: F117</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
