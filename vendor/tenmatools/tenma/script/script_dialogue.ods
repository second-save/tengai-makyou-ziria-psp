     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>おおきに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">また　おこしやす</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F143])" office:value-type="string" office:string-value="Thank you, thank you!\n&#x0a;See you soon!" calcext:value-type="string"><text:p>Thank you, thank you!\n</text:p><text:p>See you soon!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F143]); COLUMN([.F143]); 4)" office:value-type="string" office:string-value="DUPE: F143" calcext:value-type="string">
      <text:p>DUPE: F143</text:p>
     </table:table-cell>
