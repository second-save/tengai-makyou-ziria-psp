     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>かわごえ城</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F5668])" office:value-type="string" office:string-value="Kawagoe Castle" calcext:value-type="string">
