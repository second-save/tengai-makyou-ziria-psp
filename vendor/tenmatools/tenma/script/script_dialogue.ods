     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>こ　これは　タタリじゃ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">もう　白河の関は　二度と</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">通行することは　できぬ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Th-This is a curse!\n</text:p><text:p>Never again will we be able to go through the Shirakawa barrier!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1406]=[.I1406]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
