     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F2549]); COLUMN([.F2549]); 4)" office:value-type="string" office:string-value="DUPE: F2549" calcext:value-type="string">
