     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>マサカドさま<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">われわれに　力を</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">お与えください</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>O Masakado-sama!\n</text:p><text:p>Give us power!</text:p>
     </table:table-cell>
