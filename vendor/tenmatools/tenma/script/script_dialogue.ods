      <text:p>map-0x567B-0x179_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ありがとう　ございます<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">これで　この村も　救われます</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>You&apos;ve saved our village.\n</text:p><text:p>We will forever be in your debt.</text:p>
     </table:table-cell>
