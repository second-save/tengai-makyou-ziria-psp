      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x63B0-0x143_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>なんだか　わかんないけど<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">きょうは　満室なんだよ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">他を　あたって　ください！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>For some unfathomable reason, we&apos;re fully booked today! You&apos;ll have to try a different inn!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
