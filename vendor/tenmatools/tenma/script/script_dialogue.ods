    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x394D-0xBC_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>それじゃ　また　きてねー</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F992])" office:value-type="string" office:string-value="Come back anytime!" calcext:value-type="string">
      <text:p>Come back anytime!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F992]); COLUMN([.F992]); 4)" office:value-type="string" office:string-value="DUPE: F992" calcext:value-type="string">
      <text:p>DUPE: F992</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x394D-0xD6_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>３００年前　しなの国を　まとめ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">人々の　平和を　おつくりになった</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">とても　いだいな　トノさま・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>There was a great lord who brought peace to Shinano 300 years ago...\n</text:p><text:p>Shingen-sama.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F3135]=[.I3135]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
