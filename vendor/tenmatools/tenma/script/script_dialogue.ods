      <text:p>米沢城</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F1933])" office:value-type="string" office:string-value="Yonezawa Castle" calcext:value-type="string">
      <text:p>Yonezawa Castle</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F1933]); COLUMN([.F1933]); 4)" office:value-type="string" office:string-value="DUPE: F1933" calcext:value-type="string">
