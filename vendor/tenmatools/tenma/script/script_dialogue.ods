     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>この　ジパングは<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">大門教が　すべて　支配するのだ！！</text:span></text:p>
     </table:table-cell>
