     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>マサカドさま！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">わたしは　あなたさまの　忠実な</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">しもべと　なりましょうぞ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F6543])" office:value-type="string" office:string-value="O Masakado-sama!\n&#x0a;I shall be your faithful servant!" calcext:value-type="string"><text:p>O Masakado-sama!\n</text:p><text:p>I shall be your faithful servant!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F6543]); COLUMN([.F6543]); 4)" office:value-type="string" office:string-value="DUPE: F6543" calcext:value-type="string">
      <text:p>DUPE: F6543</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE71B-0x463_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>マサカドさま<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">新しい国に　わたしたちを</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">おみちびき　ください！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>O Masakado-sama!\n</text:p><text:p>Show us the way to our new country!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F6558]=[.I6558]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
