     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>神は　あなたの　行ないを　<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">いつも　見て　いらっしゃいますよ</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4141])" office:value-type="string" office:string-value="Remember: God is always watching you." calcext:value-type="string">
