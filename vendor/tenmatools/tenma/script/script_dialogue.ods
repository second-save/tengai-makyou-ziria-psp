     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>われら　大門教は　あらそいを<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">このみません！　しずかに</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いのるだけです　ジライアさん</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>The Cult of Daimon abhors conflict!\n</text:p><text:p>We want nothing more than to pray peacefully, Ziria-san!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F6529]=[.I6529]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
