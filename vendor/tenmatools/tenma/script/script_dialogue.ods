     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x6110-0xF3_4</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>だが　ここまでだ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">くらえ　デーモン族の　力！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>But this is as far as you go.\n</text:p><text:p>Behold the power of the Demon clan!</text:p>
     </table:table-cell>
