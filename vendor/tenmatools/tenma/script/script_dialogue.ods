     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xDB8B-0x5E_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>とまると　すべて　宿帳に　きろく<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">されますぜ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>I&apos;ll write your name in the inn&apos;s register!</text:p>
     </table:table-cell>
