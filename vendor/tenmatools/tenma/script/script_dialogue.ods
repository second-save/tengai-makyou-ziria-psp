    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2BA3-0x182_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>あくろう王は　大門教に　だまされて<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">いるんだわ　きっと　そうよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>King Akurou has been deceived by the Daimonists! I&apos;m sure of it!</text:p>
     </table:table-cell>
