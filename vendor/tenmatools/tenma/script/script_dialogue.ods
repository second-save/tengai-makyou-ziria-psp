     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ナマンダブツ　ナマンダブツ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ナマンダブツ　ナマンダブツ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ナマンダブツ　ナマンダブツ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Namo Amitabha...Namo Amitabha...\n</text:p><text:p>Namo Amitabha...Namo Amitabha...\n</text:p><text:p>Namo Amitabha...Namo Amitabha...</text:p>
