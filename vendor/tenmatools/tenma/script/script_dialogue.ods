      <text:p>矢切の渡し</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4451])" office:value-type="string" office:string-value="Yagiri Ferry" calcext:value-type="string">
      <text:p>Yagiri Ferry</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4451]); COLUMN([.F4451]); 4)" office:value-type="string" office:string-value="DUPE: F4451" calcext:value-type="string">
