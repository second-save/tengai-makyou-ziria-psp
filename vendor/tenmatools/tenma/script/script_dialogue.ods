     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F5668]); COLUMN([.F5668]); 4)" office:value-type="string" office:string-value="DUPE: F5668" calcext:value-type="string">
