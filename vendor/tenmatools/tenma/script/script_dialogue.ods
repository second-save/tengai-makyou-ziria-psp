     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>マサカドさまが<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お姿を　現すまで</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">わたしは　拝み続けます</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F6533])" office:value-type="string" office:string-value="I&apos;ll keep praying until Masakado-sama walks among us!" calcext:value-type="string">
