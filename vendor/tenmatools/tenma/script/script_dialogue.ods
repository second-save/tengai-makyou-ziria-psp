     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>なんと　サイダンのしたから<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">階段が　現れました</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The altar opens up, revealing a staircase.</text:p>
     </table:table-cell>
