     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>では　宿帳に　きろくいたします<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">どうぞ　ごゆっくり</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F3016])" office:value-type="string" office:string-value="I&apos;ll register you in the guest book.\n&#x0a;Have a nice stay." calcext:value-type="string"><text:p>I&apos;ll register you in the guest book.\n</text:p><text:p>Have a nice stay.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F3016]); COLUMN([.F3016]); 4)" office:value-type="string" office:string-value="DUPE: F3016" calcext:value-type="string">
