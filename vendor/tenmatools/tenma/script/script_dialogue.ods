     <table:table-cell table:formula="of:=T([.F154])" office:value-type="string" office:string-value="You look inside the casket.\n&#x0a;There is nothing inside." calcext:value-type="string"><text:p>You look inside the casket.\n</text:p><text:p>There is nothing inside.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F154]); COLUMN([.F154]); 4)" office:value-type="string" office:string-value="DUPE: F154" calcext:value-type="string">
      <text:p>DUPE: F154</text:p>
     </table:table-cell>
