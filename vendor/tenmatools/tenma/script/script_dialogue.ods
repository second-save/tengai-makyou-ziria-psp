    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x6228-0x268_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>うう〜　苦しいよ〜<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">はやく　楽にしてくれ〜</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F656])" office:value-type="string" office:string-value="Urgh...I&apos;m suffering...\n&#x0a;Please, deliver me from this pain..." calcext:value-type="string"><text:p>Urgh...I&apos;m suffering...\n</text:p><text:p>Please, deliver me from this pain...</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F656]); COLUMN([.F656]); 4)" office:value-type="string" office:string-value="DUPE: F656" calcext:value-type="string">
      <text:p>DUPE: F656</text:p>
     </table:table-cell>
