      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3654-0x4DC_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>大門教を　たおさねば<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ジパングは　ほろびてしまう</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Unless the Cult of Daimon is stopped, our beautiful Jipang shall perish...</text:p>
     </table:table-cell>
