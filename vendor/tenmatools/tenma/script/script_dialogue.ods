     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x62D0-0x1DB_1</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ヤッパシ！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">あたしも　そうじゃないかと　思ったの</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">じゃあ　ちょっと　待っててネ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Yeah, I think so too!\n</text:p><text:p>Okay, hold on!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5804]=[.I5804]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
