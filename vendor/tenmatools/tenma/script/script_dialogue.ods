     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>おいでやす<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">うちは　よろず屋でおます</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ごようむきは　なんでっしゃろ？</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F142])" office:value-type="string" office:string-value="Welcome, welcome!\n&#x0a;This is my general store.\n&#x0a;Tell me what you need!" calcext:value-type="string"><text:p>Welcome, welcome!\n</text:p><text:p>This is my general store.\n</text:p><text:p>Tell me what you need!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F142]); COLUMN([.F142]); 4)" office:value-type="string" office:string-value="DUPE: F142" calcext:value-type="string">
      <text:p>DUPE: F142</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
