     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>た・・たすけて・・・<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">マ　マ　サカド　が　よみ　がえ・・た</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>H-Help us...\n</text:p><text:p>M-Masakado...has been revived...</text:p>
