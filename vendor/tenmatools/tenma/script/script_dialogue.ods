      <text:p>map-0x3398-0x28D_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>人の　恨みや　憎しみの　こもった<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">たましいほど　マサカドは</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">よろこぶって　いうんだ</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F658])" office:value-type="string" office:string-value="Masakado delights in souls filled with regret and hatred..." calcext:value-type="string">
      <text:p>Masakado delights in souls filled with regret and hatred...</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F658]); COLUMN([.F658]); 4)" office:value-type="string" office:string-value="DUPE: F658" calcext:value-type="string">
      <text:p>DUPE: F658</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3398-0x2DF_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ここにいる　たましいは　みんな<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">マサカドに　喰われちまうんだ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">つぎは　おれの番かもしれない</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F659])" office:value-type="string" office:string-value="Masakado consumes the souls that end up here...It could be my turn next..." calcext:value-type="string">
      <text:p>Masakado consumes the souls that end up here...It could be my turn next...</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F659]); COLUMN([.F659]); 4)" office:value-type="string" office:string-value="DUPE: F659" calcext:value-type="string">
      <text:p>DUPE: F659</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3398-0x339_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>はやく　わたしたちを<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">もとの姿に　もどしてください！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F1977])" office:value-type="string" office:string-value="Please, return us to our bodies!" calcext:value-type="string">
      <text:p>Please, return us to our bodies!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F1977]); COLUMN([.F1977]); 4)" office:value-type="string" office:string-value="DUPE: F1977" calcext:value-type="string">
