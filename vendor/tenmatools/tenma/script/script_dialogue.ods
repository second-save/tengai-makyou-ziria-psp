     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>あんた　ジライアさん　だね！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">わしが　キコリ村の　村長じゃ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">村にいる　ツナデを　つれてくるのじゃ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>You must be Ziria-san!\n</text:p><text:p>I&apos;m the elder of Lumberjack Village.\n</text:p><text:p>Please, take Tsunade with you.</text:p>
     </table:table-cell>
