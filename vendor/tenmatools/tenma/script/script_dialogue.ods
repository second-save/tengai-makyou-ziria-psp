     <table:table-cell table:formula="of:=T([.F5433])" office:value-type="string" office:string-value="It&apos;s 両85 for the night.\n&#x0a;Will you stay?" calcext:value-type="string"><text:p>It&apos;s 両85 for the night.\n</text:p><text:p>Will you stay?</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F5433]); COLUMN([.F5433]); 4)" office:value-type="string" office:string-value="DUPE: F5433" calcext:value-type="string">
