     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x209B-0x791_7</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>この　殺生石の　カケラ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">少し　あれば</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">すぐ　かみなり玉　できます　デース！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>With Say Show stone piece, I make Thunder Orb real quick!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1415]=[.I1415]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
