     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ここは呉服屋です<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">来るところをお間違いじゃ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ありませんか！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>This is a kimono shop!\n</text:p><text:p>You have no business here!</text:p>
     </table:table-cell>
