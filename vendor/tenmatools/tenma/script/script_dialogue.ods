      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5CD3-0xDC_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いらっしゃいませ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ここは　宿屋でございます</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F117])" office:value-type="string" office:string-value="Welcome to the inn!" calcext:value-type="string">
