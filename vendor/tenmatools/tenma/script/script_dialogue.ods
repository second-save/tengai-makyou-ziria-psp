     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x209B-0x738_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>殺生石を　くだけるのは<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">大僧正が　お作りになられた</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">法力を持った　大カナヅチだけじゃ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Only the Great Hammer made by the Buddhist Daisoujou could smash the Sesshou-seki.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1412]=[.I1412]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
