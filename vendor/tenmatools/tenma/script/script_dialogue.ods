     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>やっぱり　なにもなかった<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">シクシク・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>There really was nothing...\n</text:p><text:p>That&apos;s just sad.</text:p>
     </table:table-cell>
