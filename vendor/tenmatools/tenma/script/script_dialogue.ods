     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x15CF-0xF1_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>は？　おとまりですか？<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">よろしいですよ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いい部屋も　空いております！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Huh? You wanna stay?\n</text:p><text:p>Sure, I have a room, just for you!</text:p>
     </table:table-cell>
