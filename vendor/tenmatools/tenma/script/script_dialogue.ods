     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4257]); COLUMN([.F4257]); 4)" office:value-type="string" office:string-value="DUPE: F4257" calcext:value-type="string">
