     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライア！　オニさんの命<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ムダに　しないためにも</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">早く　ここから　逃げよう</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ziria! We can&apos;t waste Oni Guy&apos;s sacrifice! Let&apos;s hurry!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1972]=[.I1972]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
