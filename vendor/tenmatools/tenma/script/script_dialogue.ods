     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3558-0x15B_7</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ありがとう　ございました<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">これで　もがみへ　帰れます</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Thank you so much. Now I can go back to Mogami!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F2967]=[.I2967]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
