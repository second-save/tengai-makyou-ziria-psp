    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x33B4-0x179_0</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>[color]&lt;$01&gt;</text:p>
     </table:table-cell>
     <table:table-cell/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>つづらの中を　調べた<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">中には　なにもなかった</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F2710])" office:value-type="string" office:string-value="You look inside the casket.\n&#x0a;There is nothing inside." calcext:value-type="string"><text:p>You look inside the casket.\n</text:p><text:p>There is nothing inside.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F2710]); COLUMN([.F2710]); 4)" office:value-type="string" office:string-value="DUPE: F2710" calcext:value-type="string">
      <text:p>DUPE: F2710</text:p>
     </table:table-cell>
