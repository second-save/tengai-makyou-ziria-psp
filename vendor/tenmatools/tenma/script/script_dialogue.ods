     <table:table-cell table:number-columns-repeated="4"/>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>//==================================</text:p><text:p>// map 0x14D1 (small, not used?)</text:p><text:p>//==================================</text:p>
     </table:table-cell>
