     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ふるい　伝説に　よれば<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">火の一族とは</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ガマ　ナメクジ　ヘビ族の勇者じゃ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
