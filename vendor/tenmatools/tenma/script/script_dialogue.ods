     </table:table-cell>
     <table:table-cell/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>赤地に　黄色い文字で<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">「大」と　しるされた　大きな石がある</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F7])" office:value-type="string" office:string-value="There is a large red stone marked with a yellow 大 symbol." calcext:value-type="string">
      <text:p>There is a large red stone marked with a yellow 大 symbol.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F7]); COLUMN([.F7]); 4)" office:value-type="string" office:string-value="DUPE: F7" calcext:value-type="string">
