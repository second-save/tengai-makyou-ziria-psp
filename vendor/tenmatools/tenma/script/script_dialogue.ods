     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>おおきに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">また　おこしやす</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F143])" office:value-type="string" office:string-value="Thank you, thank you!\n&#x0a;See you soon!" calcext:value-type="string"><text:p>Thank you, thank you!\n</text:p><text:p>See you soon!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F143]); COLUMN([.F143]); 4)" office:value-type="string" office:string-value="DUPE: F143" calcext:value-type="string">
      <text:p>DUPE: F143</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x345C-0xC5_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>また　おこしやす</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F144])" office:value-type="string" office:string-value="Have a nice day." calcext:value-type="string">
      <text:p>Have a nice day.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F144]); COLUMN([.F144]); 4)" office:value-type="string" office:string-value="DUPE: F144" calcext:value-type="string">
      <text:p>DUPE: F144</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:number-columns-repeated="4"/>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>//==================================</text:p><text:p>// map 0x3478</text:p><text:p>//==================================</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3478-0x29_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>民家</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F129])" office:value-type="string" office:string-value="House" calcext:value-type="string">
      <text:p>House</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F129]); COLUMN([.F129]); 4)" office:value-type="string" office:string-value="DUPE: F129" calcext:value-type="string">
      <text:p>DUPE: F129</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3478-0x4B_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアさんですね！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">あっしは　雲切の里の者です</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>You must be Ziria-san!\n</text:p><text:p>I&apos;m from Kumogiri Hamlet.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F2830]=[.I2830]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro45">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3478-0x4B_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>マントーは　ざおう温泉に　います<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T10">ざおう温泉の場所は　この村を　[color]&lt;$01&gt;</text:span><text:span text:style-name="T11">×[color]&lt;$00&gt;</text:span><text:span text:style-name="T12">　</text:span><text:span text:style-name="T11">\n</text:span></text:p><text:p><text:span text:style-name="T13">ざおう温泉を　</text:span><text:span text:style-name="T4">[color]&lt;$01&gt;△[color]&lt;$00&gt;</text:span><text:span text:style-name="T5">　とすると</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Manto is currently at Zao Hot Spring.\n</text:p><text:p>Here, let me draw you a quick map.\n</text:p><text:p>This village is [color]&lt;$01&gt;×[color]&lt;$00&gt; while Zao is [color]&lt;$01&gt;△[color]&lt;$00&gt;.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F2831]=[.I2831]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro46">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3478-0x4B_4</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>[color]&lt;$01&gt;</text:p>
     </table:table-cell>
     <table:table-cell/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>　　　　　　　・△　<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T10">　　　　　　・　　　</text:span><text:span text:style-name="T11">[color]&lt;$00&gt;</text:span><text:span text:style-name="T12">こんな　感じに　</text:span><text:span text:style-name="T11">\n</text:span></text:p><text:p><text:span text:style-name="T14">[color]&lt;$01&gt;×</text:span><text:span text:style-name="T12">・・・・・　　　</text:span><text:span text:style-name="T11">[color]&lt;$00&gt;</text:span><text:span text:style-name="T12">行った　ところです</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>[space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px]・△<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">[space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px]・[space8px][space8px][space8px][space8px][space8px]</text:span><text:span text:style-name="T3">[color]&lt;$00&gt;It&apos;s kinda\n</text:span></text:p><text:p><text:span text:style-name="T10">[space8px][space8px][space8px][space8px]</text:span><text:span text:style-name="T11">[color]&lt;$01&gt;×</text:span><text:span text:style-name="T12">・・・・・[space8px][space8px][space8px][space8px][space8px][space8px]</text:span><text:span text:style-name="T11">[color]&lt;$00&gt;like this.</text:span></text:p>
     </table:table-cell>
