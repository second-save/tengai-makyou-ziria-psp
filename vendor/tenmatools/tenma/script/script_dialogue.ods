      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5C7F-0x333_4</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>たくさん　持ってきましたから<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">必要になったら</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いつでも　来てくださいね</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>I brought loads of these back. Feel free to talk to me whenever you need more!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5298]=[.I5298]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
