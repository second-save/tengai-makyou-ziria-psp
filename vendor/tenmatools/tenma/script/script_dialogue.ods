      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3558-0x15B_1</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>わたしは　もがみの渡しの<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">船頭の娘　おサエです</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>My name is Osae. I&apos;m the daughter of Mogami&apos;s ferryman.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F2965]=[.I2965]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
