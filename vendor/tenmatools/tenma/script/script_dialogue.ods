     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>It&apos;s <text:span text:style-name="T2">両</text:span><text:span text:style-name="T3">45 for the night.\n</text:span></text:p><text:p><text:span text:style-name="T1">Will you stay?</text:span></text:p>
