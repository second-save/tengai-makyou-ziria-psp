      <text:p>茶店</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F989])" office:value-type="string" office:string-value="Tea House" calcext:value-type="string">
      <text:p>Tea House</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F989]); COLUMN([.F989]); 4)" office:value-type="string" office:string-value="DUPE: F989" calcext:value-type="string">
