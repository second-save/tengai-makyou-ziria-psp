     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>マサカドさま！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">火の勇者に　たおされた者たちを</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">呼び戻して　ください！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>O Masakado-sama!\n</text:p><text:p>Bring back those who have been killed by the Fire Heroes!</text:p>
     </table:table-cell>
