    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x24F8-0x63_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いらっしゃいませ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ここは　武具屋です</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ご用件は　何ですか？</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F106])" office:value-type="string" office:string-value="Welcome to my armory!\n&#x0a;How can I help you?" calcext:value-type="string"><text:p>Welcome to my armory!\n</text:p><text:p>How can I help you?</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F106]); COLUMN([.F106]); 4)" office:value-type="string" office:string-value="DUPE: F106" calcext:value-type="string">
      <text:p>DUPE: F106</text:p>
     </table:table-cell>
