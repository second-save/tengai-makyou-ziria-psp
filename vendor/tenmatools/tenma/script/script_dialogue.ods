     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>グウグウグ・・・・<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">グウグウグ・・・・</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">グウグウグ・・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F3113])" office:value-type="string" office:string-value="Zzz......\n&#x0a;...Zzz...\n&#x0a;......Zzz..." calcext:value-type="string"><text:p>Zzz......\n</text:p><text:p>...Zzz...\n</text:p><text:p>......Zzz...</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F3113]); COLUMN([.F3113]); 4)" office:value-type="string" office:string-value="DUPE: F3113" calcext:value-type="string">
      <text:p>DUPE: F3113</text:p>
