     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x4C39-0xA9_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>お早ようございます<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">いってらっしゃいませ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>I hope you enjoyed your stay.\n</text:p><text:p>Have a nice day.</text:p>
     </table:table-cell>
