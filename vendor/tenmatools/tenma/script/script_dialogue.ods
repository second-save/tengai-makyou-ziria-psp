     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x4A24-0xA0_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ぼくらは夏には<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">芦の湖で遊ぶんだ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>We like playing at Lake Ashi in the summer.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4283]=[.I4283]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
