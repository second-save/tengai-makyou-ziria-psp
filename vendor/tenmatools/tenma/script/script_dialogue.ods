     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x489D-0x2EB_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>気の毒な　かれらの　ために<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">１０００両の　寄付を</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">おねがい　いたします？</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Would you make a donation of <text:span text:style-name="T2">両</text:span><text:span text:style-name="T3">1,000 to provide them with the bare necessities?</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4145]=[.I4145]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
