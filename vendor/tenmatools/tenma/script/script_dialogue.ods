     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE839-0x4E9_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>火の勇者よ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">「力」を　あたえよう！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F5560])" office:value-type="string" office:string-value="Fire Heroes, I shall restore your energy!" calcext:value-type="string">
