      <text:p>月山</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F2711])" office:value-type="string" office:string-value="Mount Tsukiyama" calcext:value-type="string">
      <text:p>Mount Tsukiyama</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F2711]); COLUMN([.F2711]); 4)" office:value-type="string" office:string-value="DUPE: F2711" calcext:value-type="string">
