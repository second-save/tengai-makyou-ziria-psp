     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライア殿の　おかげで<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">　　　　この　筑波国は</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">　　　　すっかり　平和じゃ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>[space8px][space8px][space8px][space8px][space8px][space8px]Thanks to you,\n</text:p><text:p>[space8px][space8px][space8px][space8px][space8px][space8px]the lands of Tsukuba\n</text:p><text:p>[space8px][space8px][space8px][space8px][space8px][space8px]have reclaimed peace.</text:p>
     </table:table-cell>
