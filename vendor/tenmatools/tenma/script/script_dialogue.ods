     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ひと晩　６５両でございますが<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">おとまりになりますか？</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4106])" office:value-type="string" office:string-value="It&apos;s 両65 for the night.\n&#x0a;Will you stay?" calcext:value-type="string"><text:p>It&apos;s 両65 for the night.\n</text:p><text:p>Will you stay?</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4106]); COLUMN([.F4106]); 4)" office:value-type="string" office:string-value="DUPE: F4106" calcext:value-type="string">
