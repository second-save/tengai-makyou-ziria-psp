    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x246C-0x1A2_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>火の勇者　ジライアさま！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">この国を　すくえるのは　もはや</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">あなたさま　だけです！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Ziria-sama, the Fire Hero!\n</text:p><text:p>Only you can save these lands!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1607]=[.I1607]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
