     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F990]); COLUMN([.F990]); 4)" office:value-type="string" office:string-value="DUPE: F990" calcext:value-type="string">
