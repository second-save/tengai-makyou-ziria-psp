      <text:p>map-0x1DC3-0x3DD_7</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>絵図面にある　<text:span text:style-name="T4">×</text:span><text:span text:style-name="T5">印を　</text:span><text:span text:style-name="T4">\n</text:span></text:p><text:p><text:span text:style-name="T2">しらべてください　地下への</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">かくし階段が　あるはずです</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Check the spot marked by an X on the plans. You&apos;ll find a hidden stairway leading down below.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1147]=[.I1147]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
