     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F123]); COLUMN([.F123]); 4)" office:value-type="string" office:string-value="DUPE: F123" calcext:value-type="string">
      <text:p>DUPE: F123</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x24DC-0x1C7_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いってらっしゃいませ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お気をつけて　ジライアさま</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F124])" office:value-type="string" office:string-value="Take care of yourself, Ziria-sama." calcext:value-type="string">
      <text:p>Take care of yourself, Ziria-sama.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F124]); COLUMN([.F124]); 4)" office:value-type="string" office:string-value="DUPE: F124" calcext:value-type="string">
      <text:p>DUPE: F124</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x24DC-0x206_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いらっしゃいませ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">きろく　しますか？</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いえいえ　お金はいりません</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F125])" office:value-type="string" office:string-value="Good day! Would you like me to keep a record of your progress?\n&#x0a;No need to pay -- it&apos;s free!" calcext:value-type="string"><text:p>Good day! Would you like me to keep a record of your progress?\n</text:p><text:p>No need to pay -- it&apos;s free!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F125]); COLUMN([.F125]); 4)" office:value-type="string" office:string-value="DUPE: F125" calcext:value-type="string">
      <text:p>DUPE: F125</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x24DC-0x24D_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>それでは　きろく　します</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F126])" office:value-type="string" office:string-value="Let me write this down." calcext:value-type="string">
      <text:p>Let me write this down.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F126]); COLUMN([.F126]); 4)" office:value-type="string" office:string-value="DUPE: F126" calcext:value-type="string">
      <text:p>DUPE: F126</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x24DC-0x267_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>また　お気軽に　どうぞ！</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F127])" office:value-type="string" office:string-value="Come back anytime!" calcext:value-type="string">
      <text:p>Come back anytime!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F127]); COLUMN([.F127]); 4)" office:value-type="string" office:string-value="DUPE: F127" calcext:value-type="string">
      <text:p>DUPE: F127</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x24DC-0x281_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>小耳に　はさんだんだが<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ねこま村の　白ネコさまが</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">大門教の　手に　かかったそうだ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>I heard that the Cult of Daimon has captured the sacred White Cat of Nekoma Village!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1672]=[.I1672]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro8">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x24DC-0x281_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ネコなら　ネズミに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">勝てると　思ったんだがな</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">世の中　うまく　いかんもんだ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Rats overpowering a cat...\n</text:p><text:p>This world is really falling apart!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>ZenkiTN: Danjou&apos;s true form is a giant rat, but there are also rat-like common enemies (like there are kitsune in the previous country)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=IF([.F1673]=[.I1673]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x24DC-0x320_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアさま！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">わたしは　この国の　南西のはずれの</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ねこま村の　神社の者で　ございます！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ziria-sama! I come from the Nekoma Village shrine, on the southwest corner of these lands.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1674]=[.I1674]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x24DC-0x320_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>お願いがあって　まいりました<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">大門教の　封印を　とき</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">白ネコさまを　お救いください</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Please save our sacred White Cat, I beg you!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1675]=[.I1675]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x24DC-0x320_4</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>白ネコさまなら　きっと<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">大門教の　ダンジョウを</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">こらしめる　すべを　ごぞんじのはず！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>I&apos;m sure the White Cat knows how to defeat Danjou of the Cult of Daimon!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1676]=[.I1676]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x24DC-0x41E_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>白ネコさまを　お助けいただき<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ありがとうございました</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Thank you for rescuing our sacred White Cat.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1677]=[.I1677]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
