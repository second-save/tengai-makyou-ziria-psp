     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアさん<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">大門教打倒の日まで</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">がんばってください</text:span></text:p>
