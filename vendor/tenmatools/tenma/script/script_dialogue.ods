    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE50B-0x84C_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>邪神斎の　魔術だ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ナメとった　バツじゃ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F6252])" office:value-type="string" office:string-value="This is Jashinsai&apos;s magic!\n&#x0a;He&apos;s punished us for making fun of him!" calcext:value-type="string"><text:p>This is Jashinsai&apos;s magic!\n</text:p><text:p>He&apos;s punished us for making fun of him!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F6252]); COLUMN([.F6252]); 4)" office:value-type="string" office:string-value="DUPE: F6252" calcext:value-type="string">
      <text:p>DUPE: F6252</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE50B-0x878_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>急に　まっくらに　なって<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">こんな　たましいに　されたわ！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">おヨメに　いけないよー！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F6253])" office:value-type="string" office:string-value="Everything went dark, and now I&apos;m just a spirit! How am I ever going to find a husband like this?!" calcext:value-type="string">
      <text:p>Everything went dark, and now I&apos;m just a spirit! How am I ever going to find a husband like this?!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F6253]); COLUMN([.F6253]); 4)" office:value-type="string" office:string-value="DUPE: F6253" calcext:value-type="string">
      <text:p>DUPE: F6253</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE50B-0x8CA_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>どうしたことじゃ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">わしら　死んだのか・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F6254])" office:value-type="string" office:string-value="Wh-What happened?! Did we...die?" calcext:value-type="string">
      <text:p>Wh-What happened?! Did we...die?</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F6254]); COLUMN([.F6254]); 4)" office:value-type="string" office:string-value="DUPE: F6254" calcext:value-type="string">
      <text:p>DUPE: F6254</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE50B-0x8F8_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>と・・・突然・・・<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">肉体が・・・</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">消滅した！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F6248])" office:value-type="string" office:string-value="All of a sudden, my body just...disappeared!" calcext:value-type="string">
      <text:p>All of a sudden, my body just...disappeared!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F6248]); COLUMN([.F6248]); 4)" office:value-type="string" office:string-value="DUPE: F6248" calcext:value-type="string">
      <text:p>DUPE: F6248</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE50B-0x924_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ウエーン！　まつりどころ　じゃねえ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">おらあ　どうすりゃいいんだ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F6249])" office:value-type="string" office:string-value="Bwaaah! This isn&apos;t funny!\n&#x0a;What am I supposed to do?!" calcext:value-type="string"><text:p>Bwaaah! This isn&apos;t funny!\n</text:p><text:p>What am I supposed to do?!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F6249]); COLUMN([.F6249]); 4)" office:value-type="string" office:string-value="DUPE: F6249" calcext:value-type="string">
      <text:p>DUPE: F6249</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE50B-0x968_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ひでえよー！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ひでえよー！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F6250])" office:value-type="string" office:string-value="This is horrible! Horrible!" calcext:value-type="string">
      <text:p>This is horrible! Horrible!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F6250]); COLUMN([.F6250]); 4)" office:value-type="string" office:string-value="DUPE: F6250" calcext:value-type="string">
      <text:p>DUPE: F6250</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE50B-0x984_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ム・・・ムゴイ！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">けさ　目が　さめたら</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">こんな姿に・・・なさけない</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>This is too much...When I woke up this morning, I was in this state.\n</text:p><text:p>I feel miserable...</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F6278]=[.I6278]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
