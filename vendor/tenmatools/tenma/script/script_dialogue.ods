     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2990-0x57E_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>さあ　急ぎなさい！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">わたしは　ここから　祈っています</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ジパングに　平和の　戻らんことを</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F2135])" office:value-type="string" office:string-value="I shall pray for your victory.\n&#x0a;Bring peace back to Jipang!\n&#x0a;Go forth, young heroes!" calcext:value-type="string"><text:p>I shall pray for your victory.\n</text:p><text:p>Bring peace back to Jipang!\n</text:p><text:p>Go forth, young heroes!</text:p>
     </table:table-cell>
