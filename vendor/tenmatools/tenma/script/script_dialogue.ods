     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>そったら　大門教さ　かならず<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">こらしめて　くんろ！！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">たのみますだ　ジライアさん！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>They must pay for their actions!\n</text:p><text:p>We&apos;re counting on you, Ziria-san!</text:p>
     </table:table-cell>
