     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いらっしゃいませ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">きろく　しますか？</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いえいえ　お金はいりません</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F125])" office:value-type="string" office:string-value="Good day! Would you like me to keep a record of your progress?\n&#x0a;No need to pay -- it&apos;s free!" calcext:value-type="string"><text:p>Good day! Would you like me to keep a record of your progress?\n</text:p><text:p>No need to pay -- it&apos;s free!</text:p>
