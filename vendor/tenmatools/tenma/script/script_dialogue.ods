    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x31A0-0x1F7_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>お客さま！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お金が　あるときに</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">また　おこしください！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F121])" office:value-type="string" office:string-value="Good sir!\n&#x0a;Please come back when you have enough money!" calcext:value-type="string"><text:p>Good sir!\n</text:p><text:p>Please come back when you have enough money!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F121]); COLUMN([.F121]); 4)" office:value-type="string" office:string-value="DUPE: F121" calcext:value-type="string">
