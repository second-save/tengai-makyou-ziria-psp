     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>やはり　大門教の連中が<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">うしろで　糸を引いてたんですね！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F1845])" office:value-type="string" office:string-value="I knew it! Those Daimonists were behind everything!" calcext:value-type="string">
