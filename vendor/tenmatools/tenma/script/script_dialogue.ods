     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>あすは　大門教の　まつりです！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">えどの　みなさん　すべてを</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">しあわせに　できます</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Tomorrow is the festival of the Cult of Daimon! The people of Edo will know true happiness!</text:p>
     </table:table-cell>
