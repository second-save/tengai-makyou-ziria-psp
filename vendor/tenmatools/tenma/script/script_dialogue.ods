     <table:table-cell table:formula="of:=T([.F5293])" office:value-type="string" office:string-value="You find land mine, yes?\n&#x0a;You defeat clockwork soldier, yes?\n&#x0a;I am tired! I sleep now..." calcext:value-type="string"><text:p>You find land mine, yes?\n</text:p><text:p>You defeat clockwork soldier, yes?\n</text:p><text:p>I am tired! I sleep now...</text:p>
