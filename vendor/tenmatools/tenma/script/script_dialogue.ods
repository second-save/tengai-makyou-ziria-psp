      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2990-0x561_0</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>[color]&lt;$01&gt;</text:p>
     </table:table-cell>
     <table:table-cell/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>泥虫の巻物を　手に入れた<text:span text:style-name="T1">\n</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Obtained Scroll of Doromushi.\n</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F2137]=[.I2137]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2990-0x57E_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>泥虫の術は　すべての　敵を<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">泥の中に　落ちた　虫のごとく　変え</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">すばやさを　うばう術なのです</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F2134])" office:value-type="string" office:string-value="The Doromushi jutsu will reduce the speed of your opponents. They will be like insects in a mud puddle!" calcext:value-type="string">
      <text:p>The Doromushi jutsu will reduce the speed of your opponents. They will be like insects in a mud puddle!</text:p>
     </table:table-cell>
