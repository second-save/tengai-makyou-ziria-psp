     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ぐずぐずしている　ヒマは　ないぞ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">マサカドが　復活してしまう！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いそげ　ジライア！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4885])" office:value-type="string" office:string-value="Masakado may be revived soon.\n&#x0a;There&apos;s no more time to waste!\n&#x0a;Now go, young Ziria!" calcext:value-type="string"><text:p>Masakado may be revived soon.\n</text:p><text:p>There&apos;s no more time to waste!\n</text:p><text:p>Now go, young Ziria!</text:p>
     </table:table-cell>
