      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3654-0x435_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>大門教が　つき山の　ぼうさんに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ばけて　ミイラを　ふっかつさせ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">みんなを　くるしめておる</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>A Daimon Cultist, disguised as a monk, has revived the mummies of Mount Tsukiyama to torment the people.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F3036]=[.I3036]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
