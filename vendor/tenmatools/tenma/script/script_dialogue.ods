     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x209B-0xAD3_1</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>ジャスト　モーメント！</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F1418])" office:value-type="string" office:string-value="Just a moment!\n" calcext:value-type="string">
      <text:p>Just a moment!\n</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F1418]); COLUMN([.F1418]); 4)" office:value-type="string" office:string-value="DUPE: F1418" calcext:value-type="string">
