    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5AA3-0x8F1_1</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>がんばれよ！　ジライア！！</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F5132])" office:value-type="string" office:string-value="Good luck, Ziria!" calcext:value-type="string">
      <text:p>Good luck, Ziria!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F5132]); COLUMN([.F5132]); 4)" office:value-type="string" office:string-value="DUPE: F5132" calcext:value-type="string">
      <text:p>DUPE: F5132</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5AA3-0x917_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>わしらは<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">毎日　生きてゆくのが</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">つらかったが・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>They&apos;ve been working us to the bone every single day...This is a living hell.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5135]=[.I5135]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5AA3-0x917_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアさんが　この獄門島に<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">来てから　希望が　わいてきました！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">がんばってください　ジライアさん！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>But you bring us hope, Ziria-san!\n</text:p><text:p>You&apos;re going to break us out, right??</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5136]=[.I5136]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
