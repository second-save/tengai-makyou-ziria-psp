     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5D0B-0x17A_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>火の一族の　勇者さま<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ありがとうございました</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">かならずや　この国を　お救いください</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Thank you, hero of the Fire Clan.\n</text:p><text:p>May you save our beautiful Jipang!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5393]=[.I5393]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:number-columns-repeated="4"/>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>//==================================</text:p><text:p>// map 0x5D27</text:p><text:p>//==================================</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5D27-0x9B_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>神社</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F405])" office:value-type="string" office:string-value="Shrine" calcext:value-type="string">
      <text:p>Shrine</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F405]); COLUMN([.F405]); 4)" office:value-type="string" office:string-value="DUPE: F405" calcext:value-type="string">
      <text:p>DUPE: F405</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5D27-0xC3_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>白トラさまが<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">水王丸の　手にかかり</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">石に　封印されて　しまいました</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The sacred White Tiger was turned to stone by Suioumaru!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5396]=[.I5396]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5D27-0xC3_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>白トラさまは　三人の　火の勇者が<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お使いになる　三つの武器を</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">お持ちのはずです！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>He is the keeper of weapons made for the three Fire Heroes.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5397]=[.I5397]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5D27-0xC3_4</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>白トラさまの　封印を解き<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">三つの武器を　お受け取りください</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Please break the seal and receive these weapons from the sacred White Tiger!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5398]=[.I5398]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5D27-0x18F_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>まことに　ありがとう　ございました<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">いまや　マサカドの復活は　必至！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">一刻も　早く　江戸へ！！！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>You have our gratitude.\n</text:p><text:p>I&apos;m afraid Masakado&apos;s return is inevitable. You must hurry to Edo!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5399]=[.I5399]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:number-columns-repeated="4"/>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>//==================================</text:p><text:p>// map 0x5D43</text:p><text:p>//==================================</text:p>
     </table:table-cell>
