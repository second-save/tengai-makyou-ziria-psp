     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x209B-0xAD3_3</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>・・・・・・・<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">・・・・・・・・・・・・・・・・・・</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">・・・・・・・・・・・・・・・・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F1419])" office:value-type="string" office:string-value=".....................................................................\n&#x0a;....................................................................." calcext:value-type="string"><text:p>.....................................................................\n</text:p><text:p>.....................................................................</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F1419]); COLUMN([.F1419]); 4)" office:value-type="string" office:string-value="DUPE: F1419" calcext:value-type="string">
      <text:p>DUPE: F1419</text:p>
     </table:table-cell>
