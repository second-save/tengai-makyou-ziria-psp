      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3654-0x1FB_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>西の　橋を　わたって　行くと<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">とさ港　だぜ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>If you cross the western bridge and keep walking, you&apos;ll reach Tosa Harbor.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F3026]=[.I3026]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
