     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x209B-0x5AC_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライア殿！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">大トノさまへ　このことを　早く</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">お知らせくだされ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ziria-dono! Please inform our lord at once!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1407]=[.I1407]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
