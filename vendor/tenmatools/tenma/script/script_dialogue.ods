     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>お客さま！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お金が　あるときに</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">また　おこしください！</text:span></text:p>
