     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4657]); COLUMN([.F4657]); 4)" office:value-type="string" office:string-value="DUPE: F4657" calcext:value-type="string">
