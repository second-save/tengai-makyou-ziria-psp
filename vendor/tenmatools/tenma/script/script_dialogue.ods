     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F1845]); COLUMN([.F1845]); 4)" office:value-type="string" office:string-value="DUPE: F1845" calcext:value-type="string">
