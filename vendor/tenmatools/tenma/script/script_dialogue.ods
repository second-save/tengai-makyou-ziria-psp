     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>わしは　うらない師じゃ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">どれどれ　見てしんぜよう！！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ウムッ！</text:span></text:p>
     </table:table-cell>
