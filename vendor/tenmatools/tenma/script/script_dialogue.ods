    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x209B-0xAD3_6</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ハイ　できたデース！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">これで　ダンジョウの　魔神像</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">こわして　ください！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F1420])" office:value-type="string" office:string-value="It is done!\n&#x0a;Use this to break Danjou&apos;s Demon Statue!" calcext:value-type="string"><text:p>It is done!\n</text:p><text:p>Use this to break Danjou&apos;s Demon Statue!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F1420]); COLUMN([.F1420]); 4)" office:value-type="string" office:string-value="DUPE: F1420" calcext:value-type="string">
