      <text:p>map-0x53DB-0x4B_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>おまえさん　すんだ目を　しとるのお<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">わしが　ジパングの　未来を</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">占ってしんぜよう！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>You have beautiful eyes, boy.\n</text:p><text:p>A proud gaze, full of life.\n</text:p><text:p>Allow me to look into the future of Jipang!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4688]=[.I4688]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
