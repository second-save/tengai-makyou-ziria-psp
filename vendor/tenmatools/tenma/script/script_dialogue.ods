      <text:p>You find White Toad oil.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F6343]); COLUMN([.F6343]); 4)" office:value-type="string" office:string-value="DUPE: F6343" calcext:value-type="string">
