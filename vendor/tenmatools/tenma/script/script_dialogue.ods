     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3915-0x517_8</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>わしゃ　なにを　話してたんだっけ！？<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">グウグウ・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Err, what was I talking about again?\n</text:p><text:p>...Zzz...</text:p>
     </table:table-cell>
