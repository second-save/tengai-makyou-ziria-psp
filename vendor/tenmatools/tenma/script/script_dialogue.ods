      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xDD9F-0xFA_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>は？　お泊まりですか？<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">よろしいですよ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いい部屋も空いております</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>What? You want to stay? Sure, we have a free room.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F6119]=[.I6119]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
