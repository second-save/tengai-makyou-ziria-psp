     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ここにいる　たましいは　みんな<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">マサカドに　喰われちまうんだ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">つぎは　おれの番かもしれない</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F659])" office:value-type="string" office:string-value="Masakado consumes the souls that end up here...It could be my turn next..." calcext:value-type="string">
