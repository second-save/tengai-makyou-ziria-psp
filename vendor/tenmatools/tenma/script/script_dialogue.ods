     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>わたしは　毎日　教会に<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お祈りに　行っています</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">そのおかげで　ハゲが　なおりました！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>I go to church every day to pray.\n</text:p><text:p>As a result, I&apos;m no longer bald!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F663]=[.I663]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
