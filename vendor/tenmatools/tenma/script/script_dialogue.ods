    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x34E8-0x8E4_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアよ！　罪のない　動物を<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">利用する　ヒレツな　大門教の</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">野望をかならずや　くだくのじゃ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F2897])" office:value-type="string" office:string-value="Ziria! Those despicable Daimonists would even abuse innocent creatures to pursue their goals! You must stop them!" calcext:value-type="string">
      <text:p>Ziria! Those despicable Daimonists would even abuse innocent creatures to pursue their goals! You must stop them!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F2897]); COLUMN([.F2897]); 4)" office:value-type="string" office:string-value="DUPE: F2897" calcext:value-type="string">
      <text:p>DUPE: F2897</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x34E8-0x993_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ウキャキャーア！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">白いサルさま　解放してくれて</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ありがとう</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Oop chee chee!\n</text:p><text:p>Thank you for rescuing the White Monkey!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F2902]=[.I2902]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x34E8-0x9CD_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>キャ！　キャ！　キャ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ジライアさん</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ほんとに　ありがとう</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Ack! Ack! Ack!\n</text:p><text:p>Thank you so much, Ziria-san!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F2903]=[.I2903]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x34E8-0xA07_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ウキャキャキャキャ！　ウキャー！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">火の勇者さん！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">がんばってください！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Oop ack ack ack! Ack chee!\n</text:p><text:p>Good luck, Fire Hero!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F2904]=[.I2904]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
