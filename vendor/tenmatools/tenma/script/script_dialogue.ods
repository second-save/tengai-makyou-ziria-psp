     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5AA3-0x8D5_0</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>[color]&lt;$01&gt;</text:p>
     </table:table-cell>
     <table:table-cell/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>雲切の術を　さずかった</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>You learned the Kumogiri jutsu.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5133]=[.I5133]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
