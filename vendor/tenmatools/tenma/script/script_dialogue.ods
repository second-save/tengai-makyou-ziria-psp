     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F5568])" office:value-type="string" office:string-value="Maebashi Castle" calcext:value-type="string">
      <text:p>Maebashi Castle</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F5568]); COLUMN([.F5568]); 4)" office:value-type="string" office:string-value="DUPE: F5568" calcext:value-type="string">
