     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>足もとに　なにか落ちている<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">新月刀だ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>There is something on the ground.\n</text:p><text:p>It&apos;s a New Moon Sword!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8" office:value-type="string" calcext:value-type="string">
