      <text:p>x</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F2236]); COLUMN([.F2236]); 4)" office:value-type="string" office:string-value="DUPE: F2236" calcext:value-type="string">
      <text:p>DUPE: F2236</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2C83-0x260_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>あんな　大門教の　手先に<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">なりたくは　ないのに・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>We never wanted to join the Cult of Daimon...</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F2294]=[.I2294]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
