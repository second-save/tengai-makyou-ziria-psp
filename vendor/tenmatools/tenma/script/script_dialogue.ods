     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The Fire Heroes, separated, gather once again! It is in Hell that they will reunite...</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4832]=[.I4832]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
