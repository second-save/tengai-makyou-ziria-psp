     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>マサカドさま！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">わたしに　永遠の命を</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">おさずけください！！</text:span></text:p>
