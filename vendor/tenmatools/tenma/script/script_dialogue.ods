     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>安心なされぇい！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">わしの占いは　一度も</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">はずれたことは　なぁい！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Don&apos;t worry! My predictions have never been wrong!</text:p>
     </table:table-cell>
