    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x210B-0x29_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>雲切の里３</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F745])" office:value-type="string" office:string-value="Kumogiri Hamlet 3" calcext:value-type="string">
      <text:p>Kumogiri Hamlet 3</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F745]); COLUMN([.F745]); 4)" office:value-type="string" office:string-value="DUPE: F745" calcext:value-type="string">
      <text:p>DUPE: F745</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x210B-0xDF_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>あっ！　ジライヤさまだ！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ばんもう国の　雲切の里３へ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ようこそ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F746])" office:value-type="string" office:string-value="Ziria-sama! Welcome to the lands of Banmou! This is Kumogiri Hamlet 3!" calcext:value-type="string">
      <text:p>Ziria-sama! Welcome to the lands of Banmou! This is Kumogiri Hamlet 3!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F746]); COLUMN([.F746]); 4)" office:value-type="string" office:string-value="DUPE: F746" calcext:value-type="string">
      <text:p>DUPE: F746</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x210B-0xDF_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>大門教は　この国でも<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">かなり　勢力を　広げてきています！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">がんばってね　ジライアさま！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F747])" office:value-type="string" office:string-value="The Daimonists already have great influence here! Do your best, Ziria-sama!" calcext:value-type="string">
      <text:p>The Daimonists already have great influence here! Do your best, Ziria-sama!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F747]); COLUMN([.F747]); 4)" office:value-type="string" office:string-value="DUPE: F747" calcext:value-type="string">
      <text:p>DUPE: F747</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x210B-0x17C_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ツナデは　このへんじゃ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">いちばんの</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">すげえ　力持ちなんだよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F748])" office:value-type="string" office:string-value="You won&apos;t find anyone stronger than Tsunade around these parts!" calcext:value-type="string">
      <text:p>You won&apos;t find anyone stronger than Tsunade around these parts!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F748]); COLUMN([.F748]); 4)" office:value-type="string" office:string-value="DUPE: F748" calcext:value-type="string">
      <text:p>DUPE: F748</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x210B-0x17C_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>村の　すもう大会で<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">大おとこを　１００人も</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">なげとばして　優勝したんだよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F749])" office:value-type="string" office:string-value="We had a sumo tournament recently, and she beat a hundred opponents in a row by ring out!" calcext:value-type="string">
      <text:p>We had a sumo tournament recently, and she beat a hundred opponents in a row by ring out!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F749]); COLUMN([.F749]); 4)" office:value-type="string" office:string-value="DUPE: F749" calcext:value-type="string">
      <text:p>DUPE: F749</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x210B-0x204_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>この里の　北にある　ほこらに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ナメクジ仙人　というお方が</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">すんでいるそうですよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F750])" office:value-type="string" office:string-value="The Slug Hermit lives in a small shrine north from here!" calcext:value-type="string">
      <text:p>The Slug Hermit lives in a small shrine north from here!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F750]); COLUMN([.F750]); 4)" office:value-type="string" office:string-value="DUPE: F750" calcext:value-type="string">
      <text:p>DUPE: F750</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x210B-0x254_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>キツネが　さいきん<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">人を　おそう！！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">どうしたことだ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F751])" office:value-type="string" office:string-value="Lately, the kitsune have been attacking people! I wonder why?" calcext:value-type="string">
      <text:p>Lately, the kitsune have been attacking people! I wonder why?</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F751]); COLUMN([.F751]); 4)" office:value-type="string" office:string-value="DUPE: F751" calcext:value-type="string">
      <text:p>DUPE: F751</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x210B-0x28C_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>この　ばんもう国の　どこかに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ふたりめの　火の一族の　勇者が</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いるというウワサ　なんですよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F752])" office:value-type="string" office:string-value="According to rumor, the second hero of the Fire Clan is somewhere here in Banmou!" calcext:value-type="string">
      <text:p>According to rumor, the second hero of the Fire Clan is somewhere here in Banmou!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F752]); COLUMN([.F752]); 4)" office:value-type="string" office:string-value="DUPE: F752" calcext:value-type="string">
      <text:p>DUPE: F752</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x210B-0x28C_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>火の勇者　３人が<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">その力を　合わせねば</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">マサカドには　立ち向かえませんぞ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F753])" office:value-type="string" office:string-value="The three Fire Heroes must combine their powers to stand against Masakado!" calcext:value-type="string">
      <text:p>The three Fire Heroes must combine their powers to stand against Masakado!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F753]); COLUMN([.F753]); 4)" office:value-type="string" office:string-value="DUPE: F753" calcext:value-type="string">
      <text:p>DUPE: F753</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x210B-0x331_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアさんでしょ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">雲切のおやぶん　から</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">連絡を　受けていますぜ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F754])" office:value-type="string" office:string-value="You must be Ziria-san!\n&#x0a;Chief Kumogiri told us to expect you!" calcext:value-type="string"><text:p>You must be Ziria-san!\n</text:p><text:p>Chief Kumogiri told us to expect you!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F754]); COLUMN([.F754]); 4)" office:value-type="string" office:string-value="DUPE: F754" calcext:value-type="string">
      <text:p>DUPE: F754</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x210B-0x331_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>オレたちも　ジライアさんに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">命を　あずける覚悟は</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">できてますぜ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F755])" office:value-type="string" office:string-value="We&apos;re ready to give our lives for you,\n&#x0a;Ziria-san!" calcext:value-type="string"><text:p>We&apos;re ready to give our lives for you,\n</text:p><text:p>Ziria-san!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F755]); COLUMN([.F755]); 4)" office:value-type="string" office:string-value="DUPE: F755" calcext:value-type="string">
      <text:p>DUPE: F755</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:number-columns-repeated="4"/>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>//==================================</text:p><text:p>// map 0x2127</text:p><text:p>//==================================</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2127-0x9B_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>神社</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F405])" office:value-type="string" office:string-value="Shrine" calcext:value-type="string">
      <text:p>Shrine</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F405]); COLUMN([.F405]); 4)" office:value-type="string" office:string-value="DUPE: F405" calcext:value-type="string">
      <text:p>DUPE: F405</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2127-0xDC_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>わしは　この神社の　神主じゃ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">けさ　神が　村の民を　哀れんで</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">三つの　お告げを　くだされたのじゃ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>I&apos;m the priest of this shrine.\n</text:p><text:p>The Gods, in all of their mercy, sent me three revelations this morning!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1459]=[.I1459]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2127-0xDC_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>一つ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">神木を　倒し</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">新たなる橋と　せよ！　</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>First: the sacred tree must be cut down to be used as a bridge!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1460]=[.I1460]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2127-0xDC_4</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>二つ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">白光のオノを　さがし</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">その道具と　せよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Second: the Byakkou Axe must be used to cut down the sacred tree!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1461]=[.I1461]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2127-0xDC_6</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>三つ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">火の一族の　ナメクジ族を</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">白光のオノを　使う者と　せよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Third: the Fire Hero descendant of the Slug Clan must wield the Byakkou Axe!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1462]=[.I1462]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2127-0xDC_8</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>火の一族の　ジライアさまなら<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">この神の　お告げの　意味が</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">おわかりに　なるはずです！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ziria-sama, as a Fire Hero yourself, surely you understand the meaning of these divine messages.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1463]=[.I1463]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2127-0xDC_10</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>この村の民のために<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お力を　お貸し　いただけませんか？</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>I beg of you, will you assist our village?</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1464]=[.I1464]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2127-0x260_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ありがとう　ございます<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">さすがは　火の勇者！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">たしかに　おねがい　いたしましたぞ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Thank you so much.\n</text:p><text:p>You truly are a Fire Hero!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1465]=[.I1465]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2127-0x2B2_0</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>[color]&lt;$01&gt;</text:p>
     </table:table-cell>
     <table:table-cell/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>神主の　依頼を　引き受けた</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>You have accepted the priest&apos;s request.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1466]=[.I1466]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x2127-0x2D2_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ああ　ジライアさま！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">わたしは　誰を</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">たよりに　すれば　よいのでしょう！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>But Ziria-sama! You are our only hope!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1467]=[.I1467]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
