     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4465]); COLUMN([.F4465]); 4)" office:value-type="string" office:string-value="DUPE: F4465" calcext:value-type="string">
