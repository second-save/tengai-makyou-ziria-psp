     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>大門教は　マサカドさまを<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ふっかつさせ　みなさんを</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">しあわせに　するのです</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The Cult of Daimon will revive Masakado and bring happiness to us all.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F6528]=[.I6528]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
