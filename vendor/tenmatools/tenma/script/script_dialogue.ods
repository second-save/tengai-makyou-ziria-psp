     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE71B-0x4A1_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジパングの　真の平和のために<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">マサカドさまの　力が　必要なのです</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">早く　よみがえって　ください</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Only your might can bring true peace to Jipang! You must rise, Masakado-sama!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F6559]=[.I6559]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
