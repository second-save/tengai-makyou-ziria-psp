     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>オゥ！　ベリ　グー！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">これで　殺生石</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">くだくことできます　デース！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Oh! Very good!\n</text:p><text:p>Now I break Say Show stone!</text:p>
