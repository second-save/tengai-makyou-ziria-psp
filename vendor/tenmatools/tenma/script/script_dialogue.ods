    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x657F-0x3E5_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>焼愼<text:span text:style-name="T4">[f6]&lt;$2F&gt;</text:span><text:span text:style-name="T5">・・おまえがうらやましい・・</text:span><text:span text:style-name="T4">\n</text:span></text:p><text:p><text:span text:style-name="T2">オレもおまえの様に生きてみたい</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">信じなくてもいいいが</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>...I envy you.\n</text:p><text:p>Believe it or not, I wish I could live like you.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F6000]=[.I6000]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x657F-0x3E5_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ここで待っていたのは<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">オレひとりの判断だ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">おまえにしばらくついていこうと思う</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>It was my decision alone to wait here.\n</text:p><text:p>I think I&apos;ll follow you for a while.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F6001]=[.I6001]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
