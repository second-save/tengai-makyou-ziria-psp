     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>潅涼淬いらっしゃいませ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お泊まりは１０両</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">お泊まりですか</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Welcome!\n</text:p><text:p>It&apos;s <text:span text:style-name="T2">両</text:span><text:span text:style-name="T3">10 for the night.\n</text:span></text:p><text:p><text:span text:style-name="T1">Will you stay?</text:span></text:p>
