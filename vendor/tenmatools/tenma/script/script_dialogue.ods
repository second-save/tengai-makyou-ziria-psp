      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro12">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x1E87-0x6A_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>　　　　　　　コン　コオーン<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">　コン　コオーン</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">えへへへ　　　　　　コン　コオーン</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>[space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px]Yip yiiip!\n</text:p><text:p>[space8px][space8px]Yip yiiip!\n</text:p><text:p>Heeheehee![space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px][space8px]Yip yiiip!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
