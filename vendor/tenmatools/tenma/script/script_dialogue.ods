     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x56EB-0x288_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>それでは　<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ごゆっくり　お休みください</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F122])" office:value-type="string" office:string-value="Please rest well." calcext:value-type="string">
