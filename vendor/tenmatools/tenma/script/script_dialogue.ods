     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5563-0x1DE_6</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>じゃが　安心いたせ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">火の勇者なら　地獄であろうと</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">かならずや　戻って　くるじゃろう！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>But do not worry!\n</text:p><text:p>They will definitely find a way out!</text:p>
