    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x52C3-0x41_0</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>[color]&lt;$01&gt;</text:p>
     </table:table-cell>
     <table:table-cell/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>湯船には　温泉の湯が　あった<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">その湯を　浴びると　体に</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">力が　わき上がってきた</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F970])" office:value-type="string" office:string-value="The pool is filled with hot spring water.\n&#x0a;You feel reinvigorated as soon as you enter." calcext:value-type="string"><text:p>The pool is filled with hot spring water.\n</text:p><text:p>You feel reinvigorated as soon as you enter.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F970]); COLUMN([.F970]); 4)" office:value-type="string" office:string-value="DUPE: F970" calcext:value-type="string">
      <text:p>DUPE: F970</text:p>
     </table:table-cell>
