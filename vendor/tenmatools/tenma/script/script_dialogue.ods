      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x62B4-0x57_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>とうとう　あと　ひとりですね<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">がんばってください</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Only one enemy left. Hang in there!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5794]=[.I5794]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
