    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x31A0-0x254_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>また　おこしください</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F123])" office:value-type="string" office:string-value="Please come again." calcext:value-type="string">
      <text:p>Please come again.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F123]); COLUMN([.F123]); 4)" office:value-type="string" office:string-value="DUPE: F123" calcext:value-type="string">
      <text:p>DUPE: F123</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x31A0-0x26A_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いってらっしゃいませ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お気をつけて　ジライアさま</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F124])" office:value-type="string" office:string-value="Take care of yourself, Ziria-sama." calcext:value-type="string">
      <text:p>Take care of yourself, Ziria-sama.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F124]); COLUMN([.F124]); 4)" office:value-type="string" office:string-value="DUPE: F124" calcext:value-type="string">
      <text:p>DUPE: F124</text:p>
     </table:table-cell>
