     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>つづらの中を　調べた<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">中には　武者よろいが　入っていた</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>You look inside the casket.\n</text:p><text:p>There is a warrior armor inside.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5600]=[.I5600]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
