    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x16CB-0x12F_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ゴーモンは　きっと　胎内洞で<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">あなたを　まちかまえています！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">お気をつけて　ジライアさん！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Goumon must be waiting for you inside Innards Grotto!\n</text:p><text:p>Be careful, Ziria-san!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F664]=[.I664]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
