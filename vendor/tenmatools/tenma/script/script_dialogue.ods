     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x4785-0x59_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いらっしゃいませー！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ここは　茶店でーす！！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ごようは　なあに？</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F990])" office:value-type="string" office:string-value="Welcome to my tea house!\n&#x0a;How may I help you?" calcext:value-type="string"><text:p>Welcome to my tea house!\n</text:p><text:p>How may I help you?</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F990]); COLUMN([.F990]); 4)" office:value-type="string" office:string-value="DUPE: F990" calcext:value-type="string">
