     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>It&apos;s <text:span text:style-name="T2">両</text:span><text:span text:style-name="T3">50,000,000 for the night...\n</text:span></text:p><text:p><text:span text:style-name="T1">What? You ain&apos;t got that much?\n</text:span></text:p><text:p><text:span text:style-name="T1">Then get outta here!</text:span></text:p>
     </table:table-cell>
