      <text:p>map-0x5857-0x3E0_1</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>くやしいか　ジライア！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ならば　かかってくるがいい！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F5055])" office:value-type="string" office:string-value="Awww, are you mad, Ziria?\n&#x0a;In that case, prepare to fight!" calcext:value-type="string"><text:p>Awww, are you mad, Ziria?\n</text:p><text:p>In that case, prepare to fight!</text:p>
