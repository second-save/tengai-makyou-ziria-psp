      <text:p>map-0x3654-0x3C0_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>そうか　また　いらっしゃい<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ヒヒヒヒ・・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F2535])" office:value-type="string" office:string-value="I see. That&apos;s too bad.\n&#x0a;Hee hee hee..." calcext:value-type="string"><text:p>I see. That&apos;s too bad.\n</text:p><text:p>Hee hee hee...</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F2535]); COLUMN([.F2535]); 4)" office:value-type="string" office:string-value="DUPE: F2535" calcext:value-type="string">
