     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>千葉シューサク先生は<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ふるさとの　千葉国に</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">お帰りに　なられました</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Master Shuusaku has returned to his homeland of Chiba.</text:p>
     </table:table-cell>
