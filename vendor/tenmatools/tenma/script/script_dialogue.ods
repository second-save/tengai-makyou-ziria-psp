     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F5642])" office:value-type="string" office:string-value="Iwatsuki Castle" calcext:value-type="string">
      <text:p>Iwatsuki Castle</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F5642]); COLUMN([.F5642]); 4)" office:value-type="string" office:string-value="DUPE: F5642" calcext:value-type="string">
