    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x63B0-0x32C_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いよいよ　あしたですなあ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">マサカドって　どんなヤツだ？</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F5795])" office:value-type="string" office:string-value="Tomorrow&apos;s the big day, huh?\n&#x0a;I wonder what Masakado looks like." calcext:value-type="string"><text:p>Tomorrow&apos;s the big day, huh?\n</text:p><text:p>I wonder what Masakado looks like.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F5795]); COLUMN([.F5795]); 4)" office:value-type="string" office:string-value="DUPE: F5795" calcext:value-type="string">
      <text:p>DUPE: F5795</text:p>
     </table:table-cell>
