     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>また　おこしください</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F123])" office:value-type="string" office:string-value="Please come again." calcext:value-type="string">
