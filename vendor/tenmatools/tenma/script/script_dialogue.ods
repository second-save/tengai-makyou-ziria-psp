      <text:p>map-0x526F-0x1B4_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>村に　入るとき<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">温泉代として　みなさんから</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">１００両　いただいてるんです</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>To meet the increasing demand of the market, we ask all visitors to pay a small fee of <text:span text:style-name="T2">両</text:span><text:span text:style-name="T3">100.</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4464]=[.I4464]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
