      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3931-0x151_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>船頭の　はなしじゃ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">娘が　助けられたのを</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">カンバン娘から　きいたそうな</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>You rescued the daughter of the ferryman, right? I heard from a traveling poster girl.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F3129]=[.I3129]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
