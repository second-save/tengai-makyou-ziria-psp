      <text:p>map-0x2840-0x32A_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ダンジョウに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">米をくれるって　いわれたのに</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">だまされた・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>I thought Danjou would give me rice...</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1974]=[.I1974]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
