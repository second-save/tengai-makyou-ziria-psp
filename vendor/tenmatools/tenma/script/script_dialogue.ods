     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>あたる　かもね・・・<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">あたらぬ　かもね・・・</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">占うかえ？</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F2526])" office:value-type="string" office:string-value="I could be right, or I could be wrong...Should I read your fortune?" calcext:value-type="string">
      <text:p>I could be right, or I could be wrong...Should I read your fortune?</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F2526]); COLUMN([.F2526]); 4)" office:value-type="string" office:string-value="DUPE: F2526" calcext:value-type="string">
