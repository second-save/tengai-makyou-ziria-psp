    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3915-0x517_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>昼間は　ねむくて　かなわんわい！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">グウグウグウ・・・・・・・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>You see, I&apos;m a nocturnal creature.\n</text:p><text:p>I usually sleep during the day!\n</text:p><text:p>...Zzz...</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F3109]=[.I3109]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
