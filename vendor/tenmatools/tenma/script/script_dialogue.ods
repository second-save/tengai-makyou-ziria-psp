      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x57AF-0x49_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>おーい！！　大変じゃ！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">火の勇者が　ここに　おるぞぉー！！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">だれか　来てくれー！！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Heeelp!! Th-There&apos;s a Fire Hero in my house!!</text:p>
     </table:table-cell>
