    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x489D-0x177_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>気の毒な　かれらの　ために<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">１００両の　寄付を</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">おねがい　いたします？</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Would you make a donation of <text:span text:style-name="T2">両</text:span><text:span text:style-name="T3">100 to provide them with the bare necessities?</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4140]=[.I4140]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x489D-0x208_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>神は　あなたの　行ないを　<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">いつも　見て　いらっしゃいますよ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Remember: God is always watching you.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4141]=[.I4141]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x489D-0x24B_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>さあ　お入りください<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">同志と　ともに　神に　祈りましょう！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Please, come on in. Let us pray together.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4142]=[.I4142]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
