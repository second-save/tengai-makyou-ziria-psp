     </table:table-cell>
     <table:table-cell/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>何か　重たいものを<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">引きずった　跡が　つづいている</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>There are signs of a heavy object being dragged here.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1173]=[.I1173]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
