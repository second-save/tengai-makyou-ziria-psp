      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x1E17-0x1F3_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ひと晩　２５両でございますが<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">おとまりになりますか？</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F1033])" office:value-type="string" office:string-value="It&apos;s 両25 for the night.\n&#x0a;Will you stay?" calcext:value-type="string"><text:p>It&apos;s 両25 for the night.\n</text:p><text:p>Will you stay?</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F1033]); COLUMN([.F1033]); 4)" office:value-type="string" office:string-value="DUPE: F1033" calcext:value-type="string">
      <text:p>DUPE: F1033</text:p>
     </table:table-cell>
