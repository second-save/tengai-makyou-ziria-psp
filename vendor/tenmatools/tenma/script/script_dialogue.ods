     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>敵は　あと　ひとりじゃ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">　　　おそれることは　ない</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>[space8px][space8px][space8px][space8px][space8px][space8px]There is but a\n</text:p><text:p>[space8px][space8px][space8px][space8px][space8px][space8px]single foe remaining.\n</text:p><text:p>[space8px][space8px][space8px][space8px][space8px][space8px]You have nothing to fear.</text:p>
     </table:table-cell>
