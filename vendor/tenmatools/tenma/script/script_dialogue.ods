     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>板をはがすと　隠し階段があった</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F1302])" office:value-type="string" office:string-value="You remove the boards and find a hidden stairway." calcext:value-type="string">
