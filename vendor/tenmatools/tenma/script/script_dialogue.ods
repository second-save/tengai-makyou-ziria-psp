     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F4463])" office:value-type="string" office:string-value="This is Atami Village, renowned for its hot springs!" calcext:value-type="string">
      <text:p>This is Atami Village, renowned for its hot springs!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F4463]); COLUMN([.F4463]); 4)" office:value-type="string" office:string-value="DUPE: F4463" calcext:value-type="string">
