     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>呉服屋</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F390])" office:value-type="string" office:string-value="Kimono Shop" calcext:value-type="string">
      <text:p>Kimono Shop</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F390]); COLUMN([.F390]); 4)" office:value-type="string" office:string-value="DUPE: F390" calcext:value-type="string">
