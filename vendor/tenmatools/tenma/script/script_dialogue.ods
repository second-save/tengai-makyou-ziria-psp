     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>もうしわけない！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">もうしわけない！！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">もうしわけない！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>I&apos;m so sorry!\n</text:p><text:p>Really sorry!\n</text:p><text:p>Terribly sorry!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5896]=[.I5896]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
