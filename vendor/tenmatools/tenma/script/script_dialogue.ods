      <text:p>map-0x157B-0x39B_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ここは　水戸町です<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">大門教の　おかげで</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">みんな　幸せに　くらしているんです</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>This is Mito Town.\n</text:p><text:p>Thanks to the Cult of Daimon, we can all live happy lives.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
