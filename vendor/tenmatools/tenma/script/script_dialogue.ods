      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x1E6B-0x7D_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ボクは　力持ちの<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">イタズラ　こぞうだよ〜ん！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F1226])" office:value-type="string" office:string-value="I&apos;m the toughest troublemaker around!" calcext:value-type="string">
      <text:p>I&apos;m the toughest troublemaker around!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F1226]); COLUMN([.F1226]); 4)" office:value-type="string" office:string-value="DUPE: F1226" calcext:value-type="string">
