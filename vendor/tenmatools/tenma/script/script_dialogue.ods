     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3440-0x13E_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>船頭が　もどったって！？<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">さあ　出発だ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>The ferryman&apos;s back? Well, alriiiight!\n</text:p><text:p>Time to leave!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F2811]=[.I2811]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
