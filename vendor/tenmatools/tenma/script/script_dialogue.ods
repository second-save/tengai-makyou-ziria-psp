      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x21EC-0x24E_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>つぎの　ことが<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">しらべ　られます</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">１．火の一族</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Please choose among the following.\n</text:p><text:p>1. The Fire Clan</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1510]=[.I1510]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
