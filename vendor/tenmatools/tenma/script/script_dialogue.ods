     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19B7-0x306_0</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>[color]&lt;$01&gt;</text:p>
     </table:table-cell>
     <table:table-cell/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>神木が　たおれて<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">向こう岸まで　届いている</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">木を伝って　渡れそうだ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>The sacred tree fell.\n</text:p><text:p>Its trunk reaches the opposite shore.\n</text:p><text:p>You should be able to use it as a bridge.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F738]=[.I738]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19B7-0x34A_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>磐毛国</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Banmou</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F739]=[.I739]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro11">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19B7-0x4AB_1</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>あっ！　ジライア！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">エヘヘヘヘヘ・・・・</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Ah, Ziria!\n</text:p><text:p>\n</text:p><text:p>Heeheeheehee...</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F740]=[.I740]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19B7-0x4DF_1</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ねえ　ねえ！　ジライア！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">あの　おっさん　ヘンな名前ね！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">外人のクセに　貝みたいな名前！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Hey, Ziria!\n</text:p><text:p>That guy had a weird name, huh?\n</text:p><text:p>Sounded kinda made-up!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F741]=[.I741]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19B7-0x4DF_4</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>えーっと　サザエ丸じゃないし<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">アサリ丸じゃないし</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">あ！　思い出した！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>What was it again?\n</text:p><text:p>Hotty-maru? Otter-maru?</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F742]=[.I742]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro10">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19B7-0x4DF_7</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ホタテ丸さんだ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ほんと　ヘンチクリンな　名前よね！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Oh yeah! Hotel-maru!\n</text:p><text:p>What a funny name!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>ZenkiTN: in the original text, Tsunade thinks Hoteimaru&apos;s name was something about seashells. She first mentions &quot;Sazaemaru&quot; (Sazae being a turban shell), then Asarimaru (Asari being a littleneck clam) before settling on &quot;Hotatemaru&quot; (Hotate being a scallop). The &quot;Hotei&quot; in Hoteimaru however is unrelated to shells, it&apos;s the Japanese spelling for the Budai buddha. That&apos;s why I went for something else.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=IF([.F743]=[.I743]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:number-columns-repeated="4"/>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>//==================================</text:p><text:p>// map 0x19D3</text:p><text:p>//==================================</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19D3-0x29_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>雲切の里３</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Kumogiri Hamlet 3</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F745]=[.I745]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19D3-0xDF_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>あっ！　ジライヤさまだ！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ばんもう国の　雲切の里３へ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ようこそ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Ziria-sama! Welcome to the lands of Banmou! This is Kumogiri Hamlet 3!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F746]=[.I746]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19D3-0xDF_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>大門教は　この国でも<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">かなり　勢力を　広げてきています！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">がんばってね　ジライアさま！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The Daimonists already have great influence here! Do your best, Ziria-sama!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F747]=[.I747]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19D3-0x17C_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ツナデは　このへんじゃ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">いちばんの</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">すげえ　力持ちなんだよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>You won&apos;t find anyone stronger than Tsunade around these parts!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F748]=[.I748]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19D3-0x17C_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>村の　すもう大会で<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">大おとこを　１００人も</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">なげとばして　優勝したんだよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>We had a sumo tournament recently, and she beat a hundred opponents in a row by ring out!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F749]=[.I749]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19D3-0x204_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>この里の　北にある　ほこらに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ナメクジ仙人　というお方が</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">すんでいるそうですよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The Slug Hermit lives in a small shrine north from here!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F750]=[.I750]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro19">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19D3-0x254_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>キツネが　さいきん<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">人を　おそう！！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">どうしたことだ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Lately, the kitsune have been attacking people! I wonder why?</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>ZenkiTN: I went for &quot;kitsune&quot; because they&apos;re not just random foxes, but the ones from Japanese folklore. The same way I used &quot;tanuki&quot; instead of &quot;raccoons&quot;.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=IF([.F751]=[.I751]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19D3-0x28C_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>この　ばんもう国の　どこかに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ふたりめの　火の一族の　勇者が</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いるというウワサ　なんですよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>According to rumor, the second hero of the Fire Clan is somewhere here in Banmou!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F752]=[.I752]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19D3-0x28C_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>火の勇者　３人が<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">その力を　合わせねば</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">マサカドには　立ち向かえませんぞ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The three Fire Heroes must combine their powers to stand against Masakado!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F753]=[.I753]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19D3-0x331_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアさんでしょ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">雲切のおやぶん　から</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">連絡を　受けていますぜ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>You must be Ziria-san!\n</text:p><text:p>Chief Kumogiri told us to expect you!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F754]=[.I754]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19D3-0x331_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>オレたちも　ジライアさんに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">命を　あずける覚悟は</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">できてますぜ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>We&apos;re ready to give our lives for you,\n</text:p><text:p>Ziria-san!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F755]=[.I755]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:number-columns-repeated="4"/>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>//==================================</text:p><text:p>// map 0x19EF</text:p><text:p>//==================================</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x29_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>宿屋</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F111])" office:value-type="string" office:string-value="Inn" calcext:value-type="string">
      <text:p>Inn</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F111]); COLUMN([.F111]); 4)" office:value-type="string" office:string-value="DUPE: F111" calcext:value-type="string">
      <text:p>DUPE: F111</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x81_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ナメクジ仙人なら<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ふたりめの　火の勇者が　どこにいるか</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">知ってるかも　しんねえな！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Maybe the Slug Hermit knows where you can find the second Fire Hero!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F758]=[.I758]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x81_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>どえれえ　長生きしとる　そうだから<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">火の一族のことも　きっと</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">教えてくれるに　ちげえねえよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>He&apos;s lived for a long time. I&apos;m sure he knows a thing or two about the Fire Clan!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F759]=[.I759]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x130_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>うちの　じじいが　いうには<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">火の一族には　三つの族が</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">あったそうじゃ・・・ということは</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>My old man told me that the Fire Clan was made of three different tribes.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F760]=[.I760]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x130_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアさんの　ガマ族のほかに<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">火の一族には　あとふたつの　族が</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">あるっちゅう　ことかいなあ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>That must mean there&apos;s two other clans besides your own Toad clan, Ziria!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F761]=[.I761]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x1E4_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>けったいな村　だったなあ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">じいさんと　ばあさんしか</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いない村でさあ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>What a weird village that was!\n</text:p><text:p>There were only old people there!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F762]=[.I762]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x1E4_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>川べりの村で<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">たしか　太田村って</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">いったっけなあ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>I think it was called Oota Village.\n</text:p><text:p>You&apos;ll find it along the river.</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>CHECK, is this said by the same NPC?</text:p><text:p>Supper: yes</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=IF([.F763]=[.I763]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x272_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いらっしゃいませ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ここは　宿屋でございます</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F117])" office:value-type="string" office:string-value="Welcome to the inn!" calcext:value-type="string">
      <text:p>Welcome to the inn!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F117]); COLUMN([.F117]); 4)" office:value-type="string" office:string-value="DUPE: F117" calcext:value-type="string">
      <text:p>DUPE: F117</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x272_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ひと晩　１０両でございますが<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">おとまりになりますか？</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F367])" office:value-type="string" office:string-value="It&apos;s 両10 for the night.\n&#x0a;Will you stay?" calcext:value-type="string"><text:p>It&apos;s 両10 for the night.\n</text:p><text:p>Will you stay?</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F367]); COLUMN([.F367]); 4)" office:value-type="string" office:string-value="DUPE: F367" calcext:value-type="string">
      <text:p>DUPE: F367</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x2D8_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いらっしゃいませ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ここは　宿屋でございます</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F117])" office:value-type="string" office:string-value="Welcome to the inn!" calcext:value-type="string">
      <text:p>Welcome to the inn!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F117]); COLUMN([.F117]); 4)" office:value-type="string" office:string-value="DUPE: F117" calcext:value-type="string">
      <text:p>DUPE: F117</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x2D8_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ひと晩　１０両でございますが<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">おとまりになりますか？</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F367])" office:value-type="string" office:string-value="It&apos;s 両10 for the night.\n&#x0a;Will you stay?" calcext:value-type="string"><text:p>It&apos;s 両10 for the night.\n</text:p><text:p>Will you stay?</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F367]); COLUMN([.F367]); 4)" office:value-type="string" office:string-value="DUPE: F367" calcext:value-type="string">
      <text:p>DUPE: F367</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x33E_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>お客さま！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お金が　あるときに</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">また　おこしください！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F121])" office:value-type="string" office:string-value="Good sir!\n&#x0a;Please come back when you have enough money!" calcext:value-type="string"><text:p>Good sir!\n</text:p><text:p>Please come back when you have enough money!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F121]); COLUMN([.F121]); 4)" office:value-type="string" office:string-value="DUPE: F121" calcext:value-type="string">
      <text:p>DUPE: F121</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x374_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>それでは　<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ごゆっくり　お休みください</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F122])" office:value-type="string" office:string-value="Please rest well." calcext:value-type="string">
      <text:p>Please rest well.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F122]); COLUMN([.F122]); 4)" office:value-type="string" office:string-value="DUPE: F122" calcext:value-type="string">
      <text:p>DUPE: F122</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x39B_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>また　おこしください</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F123])" office:value-type="string" office:string-value="Please come again." calcext:value-type="string">
      <text:p>Please come again.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F123]); COLUMN([.F123]); 4)" office:value-type="string" office:string-value="DUPE: F123" calcext:value-type="string">
      <text:p>DUPE: F123</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro4">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x19EF-0x3B1_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>いってらっしゃいませ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">お気をつけて　ジライアさま</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F124])" office:value-type="string" office:string-value="Take care of yourself, Ziria-sama." calcext:value-type="string">
      <text:p>Take care of yourself, Ziria-sama.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F124]); COLUMN([.F124]); 4)" office:value-type="string" office:string-value="DUPE: F124" calcext:value-type="string">
