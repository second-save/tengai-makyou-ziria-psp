     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>おまえ　敵だったのか！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">シマッタ！</text:span></text:p>
