      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x458D-0xEB_7</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ざんねんダキド<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">もう少し　時間かかります！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ジライアさんも　がんばってクダサイ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>But need more time!\n</text:p><text:p>Ziria-san, you work hard too!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F3880]=[.I3880]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
