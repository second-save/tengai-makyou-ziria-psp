     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x5ABF-0x15C_13</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>さあ！　これ　あげる！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">アタシの　カラクリ兵　コワシテよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>You take! You break my clockwork soldiers!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
