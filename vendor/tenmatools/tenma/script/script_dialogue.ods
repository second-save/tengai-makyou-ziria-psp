     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>ともだチンコ！！</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F869])" office:value-type="string" office:string-value="Hey, friend! Listen!\n&#x0a;...\n&#x0a;...Penis!" calcext:value-type="string"><text:p>Hey, friend! Listen!\n</text:p><text:p>...\n</text:p><text:p>...Penis!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F869]); COLUMN([.F869]); 4)" office:value-type="string" office:string-value="DUPE: F869" calcext:value-type="string">
