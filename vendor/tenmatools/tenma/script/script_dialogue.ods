      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3654-0x344_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ううう・・・　まつことじゃ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">しんぼうが　かんじんじゃよ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Hmmm...You must wait.\n</text:p><text:p>Patience is a virtue!</text:p>
