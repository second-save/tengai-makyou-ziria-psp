     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>ウー　ウー！　ウー　ウー！</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F1643])" office:value-type="string" office:string-value="Weeee-oooow! Weeee-oooow!" calcext:value-type="string">
      <text:p>Weeee-oooow! Weeee-oooow!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F1643]); COLUMN([.F1643]); 4)" office:value-type="string" office:string-value="DUPE: F1643" calcext:value-type="string">
