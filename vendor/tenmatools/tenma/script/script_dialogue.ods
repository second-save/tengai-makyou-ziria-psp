     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>マサカドさま！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">邪神斎さま！！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">わたしどもを　お救いください！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>O Masakado-sama! O Jashinsai-sama!\n</text:p><text:p>Deliver us from our suffering!</text:p>
