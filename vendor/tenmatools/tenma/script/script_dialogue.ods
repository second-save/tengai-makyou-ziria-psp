     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ろうかを　はしらないで<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">くださいね！　しずかに！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Please be quiet!\n</text:p><text:p>No running in the hallway!</text:p>
