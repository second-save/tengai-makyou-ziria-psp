    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x657E-0x111_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>[f6]&lt;$31&gt;<text:span text:style-name="T2">筑波へ帰るのか</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">渡してやろう</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">でも急げよ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>[f6]&lt;$31&gt;Are you going back to Tsukuba? I&apos;ll take you there, but we&apos;d better hurry.</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F5997]=[.I5997]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
