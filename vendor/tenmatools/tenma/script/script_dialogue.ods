     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F3880]); COLUMN([.F3880]); 4)" office:value-type="string" office:string-value="DUPE: F3880" calcext:value-type="string">
      <text:p>DUPE: F3880</text:p>
     </table:table-cell>
