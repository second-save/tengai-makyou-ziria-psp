      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x12DB-0x152_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ひと晩　７両でございますが<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">おとまりになりますか？</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>It&apos;s <text:span text:style-name="T2">両</text:span><text:span text:style-name="T3">7 for the night.\n</text:span></text:p><text:p><text:span text:style-name="T1">Will you stay?</text:span></text:p>
     </table:table-cell>
