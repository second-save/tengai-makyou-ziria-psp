     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>われら　このジパングの<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">平和を　もとめているんですよ</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ジライアさん　信じてください！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>We only want to bring peace to Jipang. Please believe us, Ziria-san!</text:p>
     </table:table-cell>
