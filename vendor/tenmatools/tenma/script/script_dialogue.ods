    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE50B-0x9C8_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>邪神斎の　ヤロー！！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">あっついぜ！！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">おれは　燃えてきたぜ！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Damn that Jashinsai!\n</text:p><text:p>I&apos;m burning with rage!\n</text:p><text:p>Grrr! I&apos;m so fired up right now!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F6279]=[.I6279]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
