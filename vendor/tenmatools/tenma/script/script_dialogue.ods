     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x140F-0xB6B_2</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>大門教を　たおせ！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">マサカドを　復活させては　ならぬ！！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">行け！　ジライア！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F339])" office:value-type="string" office:string-value="Take down the Cult of Daimon!\n&#x0a;Prevent Masakado&apos;s revival!\n&#x0a;Go forth, young Ziria!" calcext:value-type="string"><text:p>Take down the Cult of Daimon!\n</text:p><text:p>Prevent Masakado&apos;s revival!\n</text:p><text:p>Go forth, young Ziria!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F339]); COLUMN([.F339]); 4)" office:value-type="string" office:string-value="DUPE: F339" calcext:value-type="string">
      <text:p>DUPE: F339</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
