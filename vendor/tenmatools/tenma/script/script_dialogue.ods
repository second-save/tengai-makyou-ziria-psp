    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x63B0-0x363_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>あした　ふっかつする<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">マサカドさまって</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">どんな　やつなんだろう・・・？</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>They say Masakado is coming back tomorrow, but what kind of person is he?</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
