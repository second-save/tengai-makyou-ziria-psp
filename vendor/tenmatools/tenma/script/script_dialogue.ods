     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x63B0-0x23D_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>大門教を　やっつけろー！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">エイエイオー！！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F5796])" office:value-type="string" office:string-value="Take down the Cult of Daimon! Huzzah!" calcext:value-type="string">
      <text:p>Take down the Cult of Daimon! Huzzah!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F5796]); COLUMN([.F5796]); 4)" office:value-type="string" office:string-value="DUPE: F5796" calcext:value-type="string">
      <text:p>DUPE: F5796</text:p>
     </table:table-cell>
