     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>行け　ジライア！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">　　　　エイ　エイ　オー！</text:span></text:p>
