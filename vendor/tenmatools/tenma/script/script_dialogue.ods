     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>兄さん<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">いい娘がいるよ</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>We have the best ladies, friend!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F4397]=[.I4397]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
