     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3654-0x344_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>うーむ・・・　見えるぞ<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">おまえは　ヘビ族の　勇者を</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">さがして　いるな</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F2533])" office:value-type="string" office:string-value="Hmmm...Yes, I see it.\n&#x0a;You&apos;re looking for the hero of the Snake clan." calcext:value-type="string"><text:p>Hmmm...Yes, I see it.\n</text:p><text:p>You&apos;re looking for the hero of the Snake clan.</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F2533]); COLUMN([.F2533]); 4)" office:value-type="string" office:string-value="DUPE: F2533" calcext:value-type="string">
