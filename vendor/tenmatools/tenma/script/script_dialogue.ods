    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x620C-0xC5_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>かわごえ城</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F5668])" office:value-type="string" office:string-value="Kawagoe Castle" calcext:value-type="string">
      <text:p>Kawagoe Castle</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F5668]); COLUMN([.F5668]); 4)" office:value-type="string" office:string-value="DUPE: F5668" calcext:value-type="string">
