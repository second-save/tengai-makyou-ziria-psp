    <table:table-row table:style-name="ro6">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x20B7-0x29_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>民家</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F129])" office:value-type="string" office:string-value="House" calcext:value-type="string">
      <text:p>House</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F129]); COLUMN([.F129]); 4)" office:value-type="string" office:string-value="DUPE: F129" calcext:value-type="string">
      <text:p>DUPE: F129</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1017"/>
    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x20B7-0x41_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ねこま村の　北の池に<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">白ネコが　入って行くのを</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">わしゃー　みたんじゃ！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>I saw the White Cat enter the pond north of Nekoma Village!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F1429]=[.I1429]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
      <text:p/>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="1016"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:number-columns-repeated="4"/>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>//==================================</text:p><text:p>// map 0x20D3</text:p><text:p>//==================================</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default"/>
     <table:table-cell table:style-name="ce8"/>
