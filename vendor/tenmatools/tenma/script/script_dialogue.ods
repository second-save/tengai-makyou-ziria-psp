    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x209B-0x791_1</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>ジライアさん！　ホテイ丸です！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ダンジョウの　パワーの秘密</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">魔神像デース！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Ziria-san! It is Hoteimaru!\n</text:p><text:p>Danjou power come from Demon Statue!</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>CHECK, Hoteimaru&apos;s accent</text:p>
