    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0x3915-0x517_14</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>おおっ！　わしゃ　今<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">エッチな　夢をみたぞ！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">ホーホー！　ホッホー！</text:span></text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string"><text:p>Ohhh, I was having a dirty dream!\n</text:p><text:p>Hoot-hoot! Hoot-hoot!</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce8"/>
     <table:table-cell table:formula="of:=IF([.F3115]=[.I3115]; &quot;UNTRANSLATED&quot;; &quot;&quot;)">
