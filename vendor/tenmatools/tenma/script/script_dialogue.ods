    </table:table-row>
    <table:table-row table:style-name="ro3">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>string</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>map-0xE50B-0x810_0</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string"><text:p>たすけてくれぇー！<text:span text:style-name="T1">\n</text:span></text:p><text:p><text:span text:style-name="T2">ジライアさん！</text:span><text:span text:style-name="T3">\n</text:span></text:p><text:p><text:span text:style-name="T2">なんとか　してくれぇー！</text:span></text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([.F6251])" office:value-type="string" office:string-value="Help us, Ziria-san! Please, do something!" calcext:value-type="string">
      <text:p>Help us, Ziria-san! Please, do something!</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=&quot;DUPE: &quot;&amp;ADDRESS(ROW([.F6251]); COLUMN([.F6251]); 4)" office:value-type="string" office:string-value="DUPE: F6251" calcext:value-type="string">
      <text:p>DUPE: F6251</text:p>
     </table:table-cell>
